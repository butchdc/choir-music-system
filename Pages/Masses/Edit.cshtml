@page "{id:int}"
@model choir_music_system.Pages.Masses.EditModel

@{
    ViewData["Title"] = "Edit Mass";
}

<div class="create-mass-page">

    <div class="create-mass-header">

        <div class="create-mass-header-main">

            <a asp-page="Index"
               class="btn btn-sm create-mass-back">
                <i class="bi bi-arrow-left"></i>
                Masses
            </a>

            <div class="create-mass-heading">

                <div class="create-mass-icon">
                    <i class="bi bi-calendar2-check"></i>
                </div>

                <div>
                    <div class="create-mass-kicker">
                        Mass Planning
                    </div>

                    <h1>Edit Mass</h1>

                    <p>
                        Update the Mass details and
                        presentation settings.
                    </p>
                </div>

            </div>

        </div>

    </div>


    <form method="post"
          enctype="multipart/form-data"
          class="create-mass-form">

        <input type="hidden"
               asp-for="Mass.Id" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <div class="create-mass-grid">

            <div class="create-mass-main">


                <section class="create-mass-card">

                    <div class="create-mass-card-header">

                        <div class="create-mass-card-icon">
                            <i class="bi bi-calendar-event"></i>
                        </div>

                        <div>
                            <h2>Mass Details</h2>
                            <p>
                                Update the name, date and venue
                                for this Mass.
                            </p>
                        </div>

                    </div>


                    <div class="create-mass-fields">

                        <div class="create-mass-field create-mass-field-wide">

                            <label asp-for="Mass.Name"
                                   class="form-label">
                                Mass Name
                            </label>

                            <input asp-for="Mass.Name"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Mass.Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="create-mass-field">

                            <label asp-for="Mass.MassDate"
                                   class="form-label">
                                Mass Date
                            </label>

                            <div class="create-mass-input-icon">

                                <i class="bi bi-calendar3"></i>

                                <input asp-for="Mass.MassDate"
                                       type="date"
                                       class="form-control" />

                            </div>

                            <span asp-validation-for="Mass.MassDate"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="create-mass-field">

                            <label asp-for="Mass.Venue"
                                   class="form-label">
                                Venue
                            </label>

                            <div class="create-mass-input-icon">

                                <i class="bi bi-geo-alt"></i>

                                <input asp-for="Mass.Venue"
                                       class="form-control"
                                       placeholder="e.g. Holy Cross" />

                            </div>

                            <span asp-validation-for="Mass.Venue"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </section>


                <section class="create-mass-card">

                    <div class="create-mass-card-header">

                        <div class="create-mass-card-icon">
                            <i class="bi bi-chat-left-text"></i>
                        </div>

                        <div>
                            <h2>Mass Introduction</h2>
                            <p>
                                Introduction displayed on the opening
                                Mass slide in the presentation.
                            </p>
                        </div>

                    </div>


                    <div class="create-mass-field">

                        <textarea asp-for="Mass.MassIntroduction"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Enter the introduction for this Mass..."></textarea>

                        <span asp-validation-for="Mass.MassIntroduction"
                              class="text-danger">
                        </span>

                        <div class="create-mass-help">

                            <i class="bi bi-easel2"></i>

                            <span>
                                This will be used as the subtitle
                                on the Mass title slide.
                            </span>

                        </div>

                    </div>

                </section>


                <section class="create-mass-card">

                    <div class="create-mass-card-header">

                        <div class="create-mass-card-icon">
                            <i class="bi bi-journal-text"></i>
                        </div>

                        <div>
                            <h2>Internal Notes</h2>
                            <p>
                                Planning notes for your team.
                                These are not shown in the presentation.
                            </p>
                        </div>

                    </div>


                    <div class="create-mass-field">

                        <textarea asp-for="Mass.Notes"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Optional internal notes for this Mass..."></textarea>

                        <span asp-validation-for="Mass.Notes"
                              class="text-danger">
                        </span>

                    </div>

                </section>

            </div>


            <aside class="create-mass-sidebar">

                <section class="create-mass-card create-background-card">

                    <div class="create-mass-card-header">

                        <div class="create-mass-card-icon">
                            <i class="bi bi-image"></i>
                        </div>

                        <div>
                            <h2>Presentation</h2>
                            <p>
                                PowerPoint background image.
                            </p>
                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(
                        Model.Mass.PresentationBackgroundPath))
                    {
                        <div class="edit-background-status">

                            <div class="edit-background-status-icon">
                                <i class="bi bi-check2"></i>
                            </div>

                            <div>
                                <strong>
                                    Background configured
                                </strong>

                                <span>
                                    Upload another image below
                                    to replace it.
                                </span>
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="create-background-placeholder">

                            <i class="bi bi-image"></i>

                            <strong>
                                No background selected
                            </strong>

                            <span>
                                Add one for generated
                                PowerPoint presentations.
                            </span>

                        </div>
                    }


                    <div class="create-background-upload">

                        <label asp-for="BackgroundImage"
                               class="form-label">

                            @if (!string.IsNullOrWhiteSpace(
                                Model.Mass.PresentationBackgroundPath))
                            {
                                <text>Replace Background</text>
                            }
                            else
                            {
                                <text>Choose Background</text>
                            }

                        </label>

                        <input asp-for="BackgroundImage"
                               type="file"
                               accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                               class="form-control" />

                        <div class="form-text">
                            JPG or PNG · Maximum 10 MB.
                            Leave blank to keep the existing background.
                        </div>

                        <span asp-validation-for="BackgroundImage"
                              class="text-danger">
                        </span>

                    </div>

                </section>


                <div class="create-mass-next">

                    <div class="create-mass-next-icon">
                        <i class="bi bi-music-note-list"></i>
                    </div>

                    <div>

                        <strong>
                            Music &amp; Presentation Plan
                        </strong>

                        <p>
                            Songs and presentation items are
                            managed separately in the Mass Plan.
                        </p>

                        <a asp-page="Plan"
                           asp-route-id="@Model.Mass.Id"
                           class="edit-mass-plan-link">

                            Open Mass Plan
                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>

            </aside>

        </div>


        <div class="create-mass-actions">

            <div class="create-mass-actions-info">

                <i class="bi bi-check2-circle"></i>

                <span>
                    Changes apply to this Mass only.
                </span>

            </div>


            <div class="create-mass-actions-buttons">

                <a asp-page="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-warning create-mass-submit">

                    <i class="bi bi-check2-circle me-1"></i>
                    Save Changes

                </button>

            </div>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}