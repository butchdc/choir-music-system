@page "{id:int}"
@model choir_music_system.Pages.Masses.EditModel

@{
    ViewData["Title"] = "Edit Mass";
}

<h1>Edit Mass</h1>

<form method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="Mass.Id" />

    <div class="mb-3">
        <label asp-for="Mass.Name" class="form-label"></label>
        <input asp-for="Mass.Name" class="form-control" />
        <span asp-validation-for="Mass.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Mass.MassDate" class="form-label">Mass Date</label>
        <input asp-for="Mass.MassDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Mass.Notes" class="form-label"></label>
        <textarea asp-for="Mass.Notes" class="form-control" rows="4"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="BackgroundImage" class="form-label">
            Presentation Background
        </label>

        @if (!string.IsNullOrWhiteSpace(Model.Mass.PresentationBackgroundPath))
        {
            <div class="mb-2 text-muted small">
                A presentation background is currently set.
                Upload a new image to replace it.
            </div>
        }

        <input asp-for="BackgroundImage" type="file" accept=".jpg,.jpeg,.png,image/jpeg,image/png"
               class="form-control" />

        <div class="form-text">
            Optional. Leave blank to keep the existing background.
        </div>

        <span asp-validation-for="BackgroundImage" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>