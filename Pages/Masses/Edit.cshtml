@page "{id:int}"
@model choir_music_system.Pages.Masses.EditModel

@{
    ViewData["Title"] = "Edit Mass";
}

<h1>Edit Mass</h1>

<form method="post">

    <input type="hidden" asp-for="Mass.Id" />

    <div class="mb-3">
        <label asp-for="Mass.Name" class="form-label"></label>
        <input asp-for="Mass.Name" class="form-control" />
        <span asp-validation-for="Mass.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Mass.MassDate" class="form-label">Mass Date</label>
        <input asp-for="Mass.MassDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Mass.Notes" class="form-label"></label>
        <textarea asp-for="Mass.Notes" class="form-control" rows="4"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>