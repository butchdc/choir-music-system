@page "{id:int}"
@model choir_music_system.Pages.Masses.DeleteModel

@{
    ViewData["Title"] = "Delete Mass";
}

<h1>Delete Mass</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this Mass?
</div>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Mass.Name</dd>

    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">
        @Model.Mass.MassDate.ToString("dd MMM yyyy")
    </dd>
</dl>

<p>
    This will also remove the music plan for this Mass.
    Your Music Library PDFs will not be deleted.
</p>

<form method="post">
    <button type="submit" class="btn btn-danger">
        Delete Mass
    </button>

    <a asp-page="Details" asp-route-id="@Model.Mass.Id" class="btn btn-secondary">
        Cancel
    </a>
</form>