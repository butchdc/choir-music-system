@page
@model choir_music_system.Pages.Masses.IndexModel

@{
    ViewData["Title"] = "Masses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Masses</h1>
        <p class="text-muted mb-0">
            Plan and manage music for Mass.
        </p>
    </div>

    <a asp-page="Create" class="btn btn-primary app-primary-action">
        <i class="bi bi-plus-lg"></i>
        <span>Create Mass</span>
    </a>
</div>

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-page="Index"
       class="btn btn-sm @(string.IsNullOrEmpty(Model.ActiveFilter) ? "btn-primary" : "btn-outline-secondary")">
        All
    </a>

    <a asp-page="Index" asp-route-filter="upcoming"
       class="btn btn-sm @(Model.ActiveFilter == "upcoming" ? "btn-primary" : "btn-outline-secondary")">
        Upcoming
    </a>

    <a asp-page="Index" asp-route-filter="past"
       class="btn btn-sm @(Model.ActiveFilter == "past" ? "btn-primary" : "btn-outline-secondary")">
        Past
    </a>
</div>

@if (Model.Masses.Count == 0)
{
    <div class="alert alert-info">
        No Masses have been created yet.
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Date</th>
                <th>Name</th>
                <th>Lineup</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var mass in Model.Masses)
            {
                <tr>
                    <td>
                        @mass.MassDate.ToString("dd MMM yyyy")
                    </td>

                    <td>
                        @mass.Name
                    </td>

                    <td>
                        @{
                            var lineup = mass.MusicSheets
                                .Where(x => x.MusicSheet != null)
                                .OrderBy(x => x.DisplayOrder)
                                .GroupBy(x => x.MassPart)
                                .ToList();
                        }

                        @if (lineup.Count == 0)
                        {
                            <span class="text-muted">No music planned</span>
                        }
                        else
                        {
                            <div class="mass-lineup-summary">
                                @foreach (var part in lineup)
                                {
                                    var songs = part.ToList();

                                    <div class="mass-lineup-item">
                                        <span class="mass-lineup-part">@part.Key:</span>

                                        <a asp-page="/MusicLibrary/View" asp-route-id="@songs[0].MusicSheet.Id" target="_blank"
                                           rel="noopener noreferrer" class="mass-lineup-link">
                                            @songs[0].MusicSheet.Title
                                        </a>

                                        @if (songs.Count > 1)
                                        {
                                            var extraId = $"extra-{mass.Id}-{part.Key.Replace(" ", "-")}";

                                            <button type="button" class="mass-lineup-more" data-bs-toggle="collapse"
                                                    data-bs-target="#@extraId" aria-expanded="false" aria-controls="@extraId">
                                                +@(songs.Count - 1)
                                            </button>

                                            <div class="collapse mass-lineup-extra" id="@extraId">

                                                @foreach (var extraSong in songs.Skip(1))
                                                {
                                                    <a asp-page="/MusicLibrary/View" asp-route-id="@extraSong.MusicSheet.Id" target="_blank"
                                                       rel="noopener noreferrer" class="mass-lineup-extra-link">
                                                        @extraSong.MusicSheet.Title
                                                    </a>
                                                }

                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </td>

                    <td class="text-end">
                        <div class="d-flex gap-1 justify-content-end">

                            <a asp-page="Edit" asp-route-id="@mass.Id" class="btn btn-sm btn-outline-secondary table-action"
                               title="Edit Mass" data-bs-toggle="tooltip">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <a asp-page="Index" asp-page-handler="Duplicate" asp-route-id="@mass.Id"
                               class="btn btn-sm btn-outline-success table-action" title="Duplicate Mass"
                               data-bs-toggle="tooltip">
                                <i class="bi bi-copy"></i>
                            </a>

                            <a asp-page="Plan" asp-route-id="@mass.Id" class="btn btn-sm btn-primary table-action"
                               title="Plan Music" data-bs-toggle="tooltip">
                                <i class="bi bi-music-note-list"></i>
                            </a>

                            <a asp-page="MusicPack" asp-route-id="@mass.Id" class="btn btn-sm btn-outline-primary table-action"
                               title="Generate Music Pack" data-bs-toggle="tooltip">
                                <i class="bi bi-file-earmark-pdf"></i>
                            </a>

                            <a asp-page="Delete" asp-route-id="@mass.Id" class="btn btn-sm btn-outline-danger table-action"
                               title="Delete Mass" data-bs-toggle="tooltip">
                                <i class="bi bi-trash"></i>
                            </a>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}