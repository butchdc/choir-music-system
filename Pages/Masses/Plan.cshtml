@page "{id:int}"
@model choir_music_system.Pages.Masses.PlanModel

@{
    ViewData["Title"] = "Plan Music";

    var massParts = new[]
    {
        "Entrance",
        "Kyrie",
        "Gloria",
        "Psalm",
        "Alleluia",
        "Offertory",
        "Holy",
        "Memorial Acclamation",
        "Amen",
        "Our Father",
        "Lamb of God",
        "Communion",
        "Recessional"
    };
}

@{
    var plannedSongCount = Model.Selections
        .Count(x => x.SongId.HasValue);

    var plannedPartCount = Model.Selections
        .Where(x => x.SongId.HasValue)
        .Select(x => x.MassPart)
        .Distinct()
        .Count();

    var presentationCount = Model.PlanItems
        .Count(x => x.ItemType == "Presentation");

    var totalMassParts = massParts.Length;
}


<!-- MASS PLAN HEADER -->

<div class="mass-plan-header mb-4">

    <div class="mass-plan-header-main">

        <a asp-page="Index" class="mass-plan-back" title="Back to Masses" data-bs-toggle="tooltip">

            <i class="bi bi-arrow-left"></i>

        </a>


        <div class="mass-plan-header-icon">

            <i class="bi bi-music-note-list"></i>

        </div>


        <div>

            <div class="mass-plan-header-kicker">
                Mass Planning
            </div>

            <h1>
                @Model.Mass.Name
            </h1>

            <div class="mass-plan-header-date">

                <i class="bi bi-calendar3"></i>

                @Model.Mass.MassDate.ToString("dddd, d MMMM yyyy")

            </div>

        </div>

    </div>


    <div class="mass-plan-header-actions">

        <a asp-page="Edit" asp-route-id="@Model.Mass.Id" class="mass-plan-header-button">

            <i class="bi bi-pencil"></i>
            Mass Details

        </a>

    </div>

</div>


<!-- PLAN SUMMARY -->

<div class="mass-plan-summary mb-4">

    <div class="mass-plan-summary-item">

        <div class="mass-plan-summary-icon songs">
            <i class="bi bi-music-note-beamed"></i>
        </div>

        <div>
            <strong>@plannedSongCount</strong>
            <span>Planned Songs</span>
        </div>

    </div>


    <div class="mass-plan-summary-divider"></div>


    <div class="mass-plan-summary-item">

        <div class="mass-plan-summary-icon parts">
            <i class="bi bi-list-check"></i>
        </div>

        <div>
            <strong>@plannedPartCount / @totalMassParts</strong>
            <span>Mass Parts</span>
        </div>

    </div>


    <div class="mass-plan-summary-divider"></div>


    <div class="mass-plan-summary-item">

        <div class="mass-plan-summary-icon presentation">
            <i class="bi bi-file-earmark-slides"></i>
        </div>

        <div>
            <strong>@presentationCount</strong>
            <span>Presentation Items</span>
        </div>

    </div>


    <div class="mass-plan-summary-progress">

        <div class="mass-plan-summary-progress-label">

            <span>Music Planning</span>

            <strong>
                @(totalMassParts == 0
                    ? 0
                    : (int)Math.Round(
                        (double)plannedPartCount /
                        totalMassParts * 100))%
            </strong>

        </div>

        <div class="progress">

            <div class="progress-bar" role="progressbar"
                 style="width: @(totalMassParts == 0
                                                                                                                                                                                                                                                                                    ? 0
                                                                                                                                                                                                                                                                                    : (int)Math.Round(
                                                                                                                                                                                                                                                                                        (double)plannedPartCount /
                                                                                                                                                                                                                                                                                        totalMassParts * 100))%">
            </div>

        </div>

    </div>

</div>

<form method="post" id="musicPlanForm">

    <div id="massParts" class="mass-parts-grid">

        @{
            var partNumber = 0;
        }

        @foreach (var part in massParts)
        {
            partNumber++;

            var partSelections = Model.Selections
                .Where(x => x.MassPart == part)
                .OrderBy(x => x.DisplayOrder)
                .ToList();

            var hasPlannedSong = partSelections
                .Any(x => x.SongId.HasValue);


            <div class="mass-part @(hasPlannedSong ? "is-planned" : "is-unplanned")" data-mass-part="@part">

                <!-- PART HEADER -->

                <div class="mass-part-header">

                    <div class="mass-part-heading">

                        <div class="mass-part-number">
                            @partNumber
                        </div>

                        <div>

                            <div class="mass-part-title">
                                @part
                            </div>

                            <div class="mass-part-status">

                                @if (hasPlannedSong)
                                {
                                    <span class="planned">
                                        <i class="bi bi-check-circle-fill"></i>

                                        @partSelections.Count(x => x.SongId.HasValue)
                                        song@(partSelections.Count(x => x.SongId.HasValue) == 1 ? "" : "s")
                                    </span>
                                }
                                else
                                {
                                    <span class="unplanned">
                                        <i class="bi bi-circle"></i>
                                        Not planned
                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <div class="mass-part-icon">

                        @switch (part)
                        {
                            case "Entrance":
                                <i class="bi bi-door-open"></i>
                                break;

                            case "Kyrie":
                                <i class="bi bi-heart"></i>
                                break;

                            case "Gloria":
                                <i class="bi bi-stars"></i>
                                break;

                            case "Psalm":
                                <i class="bi bi-book"></i>
                                break;

                            case "Alleluia":
                                <i class="bi bi-music-note-beamed"></i>
                                break;

                            case "Offertory":
                                <i class="bi bi-gift"></i>
                                break;

                            case "Holy":
                                <i class="bi bi-stars"></i>
                                break;

                            case "Memorial Acclamation":
                                <i class="bi bi-cross"></i>
                                break;

                            case "Amen":
                                <i class="bi bi-check2-circle"></i>
                                break;

                            case "Our Father":
                                <i class="bi bi-people"></i>
                                break;

                            case "Lamb of God":
                                <i class="bi bi-peace"></i>
                                break;

                            case "Communion":
                                <i class="bi bi-cup-hot"></i>
                                break;

                            case "Recessional":
                                <i class="bi bi-box-arrow-right"></i>
                                break;

                            default:
                                <i class="bi bi-music-note"></i>
                                break;
                        }

                    </div>

                </div>


                <!-- SONGS -->

                <div class="mass-part-body">

                    <div class="music-rows">

                        @foreach (var selection in partSelections)
                        {
                            var selectedMusic = selection.SongId.HasValue
                                ? Model.Songs.FirstOrDefault(
                                    x => x.Id == selection.SongId.Value)
                                : null;


                            <div class="music-row">

                                <div class="music-picker position-relative">

                                    <div class="mass-song-search-wrap">

                                        <i class="bi bi-search"></i>

                                        <input type="text" class="form-control music-search"
                                               value="@(
                                               selectedMusic is null
                                                   ? ""
                                                   : string.Join(
                                                       " — ",
                                                       new[]
                                                       {
                                                                                                                                                                    selectedMusic.Title,
                                                                                                                                                                    selectedMusic.Composer,
                                                                                                                                                                    string.IsNullOrWhiteSpace(selectedMusic.Arrangement)
                                                                                                                                                                        ? null
                                                                                                                                                                        : $"Arr: {selectedMusic.Arrangement}",
                                                                                                                                                                    selectedMusic.SuggestedMassPart,
                                                                                                                                                                    string.IsNullOrWhiteSpace(selectedMusic.Key)
                                                                                                                                                                        ? null
                                                                                                                                                                        : $"Key: {selectedMusic.Key}"
                                                       }
                                                       .Where(x => !string.IsNullOrWhiteSpace(x))
                                                   )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                )"
                                               data-music-id="@selectedMusic?.Id" placeholder="Search music..."
                                               autocomplete="off" />

                                    </div>


                                    <div class="music-results list-group position-absolute w-100 shadow"
                                         style="z-index: 1000; max-height: 250px; overflow-y: auto; display: none;">
                                    </div>

                                </div>


                                <div class="mass-song-actions">

                                    <a class="btn view-music"
                                       href="@(selectedMusic is null
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ? "#"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                : $"/MusicLibrary/View/{selectedMusic.Id}")"
                                       target="_blank" rel="noopener noreferrer"
                                       style="@(selectedMusic is null ? "display:none;" : "")" title="View music sheet"
                                       data-bs-toggle="tooltip">

                                        <i class="bi bi-file-earmark-pdf"></i>

                                    </a>


                                    <button type="button" class="btn remove-song" title="Remove song" data-bs-toggle="tooltip">

                                        <i class="bi bi-x-lg"></i>

                                    </button>

                                </div>

                            </div>
                        }

                    </div>


                    <button type="button" class="add-song">

                        <i class="bi bi-plus-lg"></i>

                        Add song

                    </button>

                </div>

            </div>
        }

    </div>
    <div class="music-plan-actions music-plan-actions-sticky">

        <div class="music-plan-actions-info">

            <div class="music-plan-actions-icon">
                <i class="bi bi-check2-circle"></i>
            </div>

            <div>
                <strong>Music Selection</strong>

                <span>
                    <div class="music-plan-actions-info">

                        <div class="music-plan-actions-icon">
                            <i class="bi bi-music-note-list"></i>
                        </div>

                        <div>
                            <strong>
                                <span id="musicPlanSelectedCount">
                                    @plannedSongCount
                                </span>
                                song@(plannedSongCount == 1 ? "" : "s") selected
                            </strong>

                            <span>
                                Changes are saved when you click Save Music Plan.
                            </span>
                        </div>

                    </div>
                    Save your song selections before continuing.
                </span>
            </div>

        </div>


        <div class="music-plan-actions-buttons">

            <a asp-page="Index" class="btn music-plan-cancel">

                Cancel

            </a>


            <button type="submit" class="btn music-plan-save">

                <i class="bi bi-check-lg"></i>

                Save Music Plan

            </button>

        </div>

    </div>

</form>

<!-- PRESENTATION ORDER -->

<div class="presentation-order-section">

    <div class="presentation-order-heading">

        <div>

            <div class="presentation-order-kicker">
                PowerPoint Flow
            </div>

            <h3>
                Mass Presentation Order
            </h3>

            <p>
                Songs and presentation items will appear in this order
                in the generated PowerPoint.
            </p>

        </div>


        @if (Model.PlanItems.Count > 0)
        {
            <div class="presentation-order-count">

                <i class="bi bi-list-ol"></i>

                <strong>
                    @Model.PlanItems.Count
                </strong>

                item@(Model.PlanItems.Count == 1 ? "" : "s")

            </div>
        }

    </div>


    @if (Model.PlanItems.Count == 0)
    {
        <div class="presentation-order-empty">

            <div class="presentation-order-empty-icon">
                <i class="bi bi-file-earmark-slides"></i>
            </div>

            <div>
                <strong>
                    No presentation items yet
                </strong>

                <p>
                    Add songs above or add a Presentation Library item below.
                </p>
            </div>

        </div>
    }
    else
    {
        <div class="presentation-timeline" id="massPlanList">

            @{
                var itemNumber = 0;
            }

            @foreach (var planItem in Model.PlanItems.OrderBy(x => x.DisplayOrder))
            {
                itemNumber++;


                <div class="mass-plan-item presentation-timeline-item @(planItem.ItemType == "Song" ? "is-song" : "is-presentation")"
                     data-plan-item-id="@planItem.Id">

                    <!-- ORDER -->

                    <div class="presentation-order-number">

                        <span class="plan-item-number">
                            @itemNumber
                        </span>

                    </div>


                    <!-- ICON -->

                    <div class="presentation-item-icon">

                        @if (planItem.ItemType == "Song")
                        {
                            <i class="bi bi-music-note-beamed"></i>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-slides"></i>
                        }

                    </div>


                    <!-- DETAILS -->

                    <div class="presentation-item-content">

                        @if (planItem.ItemType == "Song" &&
                             planItem.Song is not null)
                        {
                            <div class="presentation-item-type">
                                Song
                            </div>

                            <div class="presentation-item-title">
                                @planItem.Song.Title
                            </div>

                            <div class="presentation-item-meta">

                                @if (!string.IsNullOrWhiteSpace(planItem.MassPart))
                                {
                                    <span class="presentation-item-part">
                                        @planItem.MassPart
                                    </span>
                                }


                                @if (!string.IsNullOrWhiteSpace(planItem.Song.Composer))
                                {
                                    <span>
                                        <i class="bi bi-person"></i>
                                        @planItem.Song.Composer
                                    </span>
                                }

                            </div>
                        }
                        else if (planItem.ItemType == "Presentation")
                        {
                            @if (planItem.PresentationItem is not null)
                            {
                                <div class="presentation-item-type">
                                    @planItem.PresentationItem.Type
                                </div>

                                <a asp-page="/PresentationLibrary/Edit" asp-route-id="@planItem.PresentationItem.Id"
                                   asp-route-returnUrl="@($"{Request.Path}{Request.QueryString}")" class="presentation-item-title">

                                    @planItem.PresentationItem.Title

                                </a>


                                <div class="presentation-item-meta">

                                    @if (!string.IsNullOrWhiteSpace(planItem.MassPart))
                                    {
                                        <span class="presentation-item-part">
                                            @planItem.MassPart
                                        </span>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(
                                        planItem.PresentationItem.Language))
                                    {
                                        <span>

                                            <i class="bi bi-translate"></i>

                                            @planItem.PresentationItem.Language

                                        </span>
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="presentation-item-type text-danger">
                                    Presentation
                                </div>

                                <div class="presentation-item-title text-danger">
                                    Presentation item unavailable
                                </div>
                            }
                        }

                    </div>


                    <!-- ACTIONS -->

                    <div class="presentation-item-actions">

                        <button type="button" class="btn move-up" title="Move up" data-bs-toggle="tooltip">

                            <i class="bi bi-chevron-up"></i>

                        </button>


                        <button type="button" class="btn move-down" title="Move down" data-bs-toggle="tooltip">

                            <i class="bi bi-chevron-down"></i>

                        </button>


                        @if (planItem.ItemType == "Presentation")
                        {
                            <form method="post" asp-page-handler="RemovePlanItem">

                                <input type="hidden" name="id" value="@Model.Mass.Id" />

                                <input type="hidden" name="planItemId" value="@planItem.Id" />

                                <button type="submit" class="btn presentation-remove" title="Remove presentation item"
                                        data-bs-toggle="tooltip">

                                    <i class="bi bi-trash"></i>

                                </button>

                            </form>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>


<!-- ADD PRESENTATION ITEM -->

<div class="add-presentation-section">

    <div class="add-presentation-header">

        <div class="add-presentation-header-icon">
            <i class="bi bi-file-earmark-slides"></i>
        </div>

        <div>
            <div class="add-presentation-kicker">
                Presentation Library
            </div>

            <h3>Add Presentation Item</h3>

            <p>
                Add a prayer, response, creed, notice or other reusable
                presentation item to this Mass.
            </p>
        </div>

    </div>


    <form method="post" asp-page-handler="AddPresentation">

        <input type="hidden" name="id" value="@Model.Mass.Id" />


        <div class="add-presentation-fields">

            <!-- PRESENTATION ITEM -->

            <div class="add-presentation-field presentation-field-main">

                <label class="form-label">
                    Presentation Item
                </label>

                <div class="presentation-picker position-relative">

                    <div class="presentation-search-wrap">

                        <i class="bi bi-search"></i>

                        <input type="text" id="presentationSearch" class="form-control presentation-search"
                               placeholder="Search title, type or language..." autocomplete="off" />

                    </div>


                    <input type="hidden" id="presentationItemId" name="presentationItemId" />


                    <div id="presentationResults"
                         class="presentation-search-results list-group position-absolute w-100">
                    </div>

                </div>

            </div>


            <!-- MASS PART -->

            <div class="add-presentation-field presentation-field-part">

                <label class="form-label">
                    Mass Part
                </label>

                <div class="presentation-select-wrap">

                    <i class="bi bi-list-check"></i>

                    <select name="massPart" class="form-select">

                        <option value="">
                            Not specified
                        </option>

                        @foreach (var part in massParts)
                        {
                            <option value="@part">
                                @part
                            </option>
                        }

                    </select>

                </div>

            </div>


            <!-- ADD -->

            <div class="add-presentation-action">

                <button type="submit" class="btn add-presentation-button">

                    <i class="bi bi-plus-lg"></i>

                    Add Item

                </button>

            </div>

        </div>

    </form>


    <div class="add-presentation-footer">

        <i class="bi bi-info-circle"></i>

        <span>
            The same Presentation Library item can be added more than once
            and positioned anywhere in the presentation order.
        </span>

    </div>

</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("musicPlanForm");

            const presentationLibrary = [
                                                    @foreach (var item in Model.PresentationLibrary
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .OrderBy(x => x.Type)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    .ThenBy(x => x.Title))
                {
                    @:{
                                                                                                    @:id: @item.Id,
                    @:title: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Title))",
                    @:type: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Type ?? ""))",
                    @:language: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Language ?? ""))"
                                                                                                @:},
            }
                                                ];

        const musicLibrary = [                                                                                                                                        @foreach (var music in Model.Songs)
            {
                @:{
                                                                                                                                                                                                                                                                                                                                                    @:id: @music.Id,
            @:title: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(music.Title))",
            @:composer: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(music.Composer ?? ""))",
            @:arrangement: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(music.Arrangement ?? ""))",
            @:suggestedPart: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(music.SuggestedMassPart ?? ""))",
            @:key: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(music.Key ?? ""))"
                                                                                                                                                                                                                                                                                                                                                                                        @:},
        }
                                                                                                                                                                                            ];
        const presentationSearch =
            document.getElementById("presentationSearch");

        const presentationItemId =
            document.getElementById("presentationItemId");

        const presentationResults =
            document.getElementById("presentationResults");


        function renderPresentationResults(search) {

            if (
                !presentationSearch ||
                !presentationItemId ||
                !presentationResults
            ) {
                return;
            }


            presentationResults.innerHTML = "";


            const query =
                (search || "")
                    .toLowerCase()
                    .trim();

            if (query.length < 3) {
                presentationResults.innerHTML = "";
                presentationResults.style.display = "none";
                return;
            }

            let matches = presentationLibrary;


            if (query) {

                matches = presentationLibrary
                    .filter(item => {

                        const searchableText = [
                            item.title,
                            item.type,
                            item.language
                        ]
                            .join(" ")
                            .toLowerCase();

                        return searchableText.includes(query);
                    })
                    .sort((a, b) => {

                        const aExact =
                            a.title.toLowerCase() === query;

                        const bExact =
                            b.title.toLowerCase() === query;


                        if (aExact !== bExact) {
                            return aExact ? -1 : 1;
                        }


                        const aStarts =
                            a.title.toLowerCase().startsWith(query);

                        const bStarts =
                            b.title.toLowerCase().startsWith(query);


                        if (aStarts !== bStarts) {
                            return aStarts ? -1 : 1;
                        }


                        return a.title.localeCompare(b.title);
                    });

            }


            matches = matches.slice(0, 15);


            if (matches.length === 0) {

                const empty =
                    document.createElement("div");

                empty.className =
                    "presentation-search-empty";

                empty.innerHTML = `
                                                <i class="bi bi-search"></i>
                                                <span>No presentation items found</span>
                                            `;

                presentationResults.appendChild(empty);

                presentationResults.style.display = "block";

                return;
            }


            matches.forEach(item => {

                const button =
                    document.createElement("button");

                button.type = "button";

                button.className =
                    "list-group-item list-group-item-action presentation-result";


                const icon =
                    document.createElement("div");

                icon.className =
                    "presentation-result-icon";

                icon.innerHTML =
                    '<i class="bi bi-file-earmark-slides"></i>';


                const content =
                    document.createElement("div");

                content.className =
                    "presentation-result-content";


                const title =
                    document.createElement("div");

                title.className =
                    "presentation-result-title";

                title.textContent =
                    item.title;


                const meta =
                    document.createElement("div");

                meta.className =
                    "presentation-result-meta";


                const metaParts = [];

                if (item.type) {
                    metaParts.push(item.type);
                }

                if (item.language) {
                    metaParts.push(item.language);
                }

                meta.textContent =
                    metaParts.join(" • ");


                content.appendChild(title);

                if (metaParts.length > 0) {
                    content.appendChild(meta);
                }


                button.appendChild(icon);
                button.appendChild(content);


                button.addEventListener("click", function () {

                    presentationSearch.value =
                        item.title;

                    presentationItemId.value =
                        item.id;

                    presentationSearch.classList
                        .remove("is-invalid");

                    presentationResults.style.display =
                        "none";
                });


                presentationResults.appendChild(button);

            });


            presentationResults.style.display =
                "block";
        }
        if (presentationSearch) {

            presentationSearch.addEventListener(
                "focus",
                function () {

                    const value =
                        presentationSearch.value
                            .trim();

                    if (value.length >= 3) {
                        renderPresentationResults(value);
                    }

                }
            );


            presentationSearch.addEventListener(
                "input",
                function () {

                    if (presentationItemId) {
                        presentationItemId.value = "";
                    }

                    presentationSearch.classList.remove(
                        "is-invalid"
                    );

                    renderPresentationResults(
                        presentationSearch.value
                    );

                }
            );

        }


        document.addEventListener(
            "click",
            function (event) {

                if (
                    presentationResults &&
                    !event.target.closest(".presentation-picker")
                ) {
                    presentationResults.style.display =
                        "none";
                }

            }
        );

        const addPresentationForm =
            presentationSearch?.closest("form");

        if (addPresentationForm) {

            addPresentationForm.addEventListener(
                "submit",
                function (event) {

                    if (
                        presentationSearch &&
                        presentationSearch.value.trim() &&
                        !presentationItemId.value
                    ) {

                        event.preventDefault();

                        presentationSearch.classList
                            .add("is-invalid");

                        presentationSearch.focus();

                        renderPresentationResults(
                            presentationSearch.value
                        );

                    }

                }
            );

        }

        function createMusicRow() {

            const row = document.createElement("div");

            row.className = "music-row";

            row.innerHTML = `
                                                                <div class="music-picker position-relative">

                                                                    <div class="mass-song-search-wrap">

                                                                        <i class="bi bi-search"></i>

                                                                        <input type="text"
                                                                               class="form-control music-search"
                                                                               data-music-id=""
                                                                               placeholder="Search music..."
                                                                               autocomplete="off" />

                                                                    </div>

                                                                    <div class="music-results list-group position-absolute w-100 shadow"
                                                                         style="z-index: 1000; max-height: 250px; overflow-y: auto; display: none;">
                                                                    </div>

                                                                </div>

                                                                <div class="mass-song-actions">

                                                                    <a class="btn view-music"
                                                                       href="#"
                                                                       target="_blank"
                                                                       rel="noopener noreferrer"
                                                                       style="display:none;"
                                                                       title="View music sheet">

                                                                        <i class="bi bi-file-earmark-pdf"></i>

                                                                    </a>

                                                                    <button type="button"
                                                                            class="btn remove-song"
                                                                            title="Remove song">

                                                                        <i class="bi bi-x-lg"></i>

                                                                    </button>

                                                                </div>
                                                            `;

            return row;
        }

        function updateSelectedSongCount() {

            const counter =
                document.getElementById("musicPlanSelectedCount");

            if (!counter) {
                return;
            }

            const selectedCount =
                Array.from(
                    document.querySelectorAll(
                        ".mass-part .music-search"
                    )
                )
                    .filter(input =>
                        input.dataset.musicId
                    )
                    .length;

            counter.textContent =
                selectedCount;
        }

        document.addEventListener("input", function (event) {

            if (!event.target.classList.contains("music-search")) {
                return;
            }

            const input = event.target;

            const picker =
                input.closest(".music-picker");

            const results =
                picker.querySelector(".music-results");

            const search =
                input.value.toLowerCase().trim();

            input.dataset.musicId = "";
            input.classList.remove("is-invalid");

            results.innerHTML = "";

            if (!search) {
                results.style.display = "none";
                return;
            }

            const massPart =
                input.closest(".mass-part").dataset.massPart;

            const matches = musicLibrary
                .filter(music => {

                    const searchableText = [
                        music.title,
                        music.composer,
                        music.arrangement,
                        music.suggestedPart,
                        music.key
                    ]
                        .join(" ")
                        .toLowerCase();

                    return searchableText.includes(search);
                })
                .sort((a, b) => {

                    const aExactTitle =
                        a.title.toLowerCase() === search;

                    const bExactTitle =
                        b.title.toLowerCase() === search;

                    if (aExactTitle !== bExactTitle) {
                        return aExactTitle ? -1 : 1;
                    }

                    const aTitleStarts =
                        a.title.toLowerCase().startsWith(search);

                    const bTitleStarts =
                        b.title.toLowerCase().startsWith(search);

                    if (aTitleStarts !== bTitleStarts) {
                        return aTitleStarts ? -1 : 1;
                    }

                    const aSuggested =
                        a.suggestedPart.toLowerCase() ===
                        massPart.toLowerCase();

                    const bSuggested =
                        b.suggestedPart.toLowerCase() ===
                        massPart.toLowerCase();

                    if (aSuggested !== bSuggested) {
                        return aSuggested ? -1 : 1;
                    }

                    return a.title.localeCompare(b.title);
                })
                .slice(0, 15);

            if (matches.length === 0) {
                results.style.display = "none";
                return;
            }

            matches.forEach(music => {

                const item =
                    document.createElement("button");

                item.type = "button";

                item.className =
                    "list-group-item list-group-item-action";

                const title =
                    document.createElement("div");

                title.className = "fw-semibold";
                title.textContent = music.title;

                const details =
                    document.createElement("div");

                details.className = "small text-muted";

                const detailParts = [];

                if (music.composer) {
                    detailParts.push(music.composer);
                }

                if (music.arrangement) {
                    detailParts.push(`Arr: ${music.arrangement}`);
                }

                if (music.suggestedPart) {
                    detailParts.push(music.suggestedPart);
                }

                if (music.key) {
                    detailParts.push(`Key: ${music.key}`);
                }

                details.textContent =
                    detailParts.join(" • ");

                item.appendChild(title);

                if (detailParts.length > 0) {
                    item.appendChild(details);
                }

                item.addEventListener("click", function () {

                    const selectedDetails = [];

                    selectedDetails.push(music.title);

                    if (music.composer) {
                        selectedDetails.push(music.composer);
                    }

                    if (music.arrangement) {
                        selectedDetails.push(`Arr: ${music.arrangement}`);
                    }

                    if (music.suggestedPart) {
                        selectedDetails.push(music.suggestedPart);
                    }

                    if (music.key) {
                        selectedDetails.push(`Key: ${music.key}`);
                    }

                    input.value = selectedDetails.join(" — ");
                    input.dataset.musicId = music.id;
                    const row =
                        input.closest(".music-row");

                    const viewButton =
                        row.querySelector(".view-music");

                    viewButton.href =
                        `/MusicLibrary/View/${music.id}`;

                    viewButton.style.display = "";

                    results.style.display = "none";
                    updateSelectedSongCount();
                });

                results.appendChild(item);
            });

            results.style.display = "block";
        });


        document.addEventListener("click", function (event) {

            const addButton =
                event.target.closest(".add-song");

            if (addButton) {

                const card =
                    addButton.closest(".mass-part");

                const rows =
                    card.querySelector(".music-rows");

                const newRow = createMusicRow();

                rows.appendChild(newRow);

                newRow
                    .querySelector(".music-search")
                    .focus();

                return;
            }


            const removeButton =
                event.target.closest(".remove-song");

            if (removeButton) {

                const card =
                    removeButton.closest(".mass-part");

                const rows =
                    card.querySelector(".music-rows");

                const row =
                    removeButton.closest(".music-row");

                if (
                    rows.querySelectorAll(".music-row").length > 1
                ) {
                    row.remove();
                }
                else {
                    const input =
                        row.querySelector(".music-search");

                    input.value = "";
                    input.dataset.musicId = "";
                    const viewButton =
                        row.querySelector(".view-music");

                    viewButton.href = "#";
                    viewButton.style.display = "none";
                }
                updateSelectedSongCount();

                return;
            }


            if (!event.target.closest(".music-picker")) {
                document
                    .querySelectorAll(".music-results")
                    .forEach(results => {
                        results.style.display = "none";
                    });
            }

        });


        form.addEventListener("submit", function (event) {

            form.querySelectorAll(".generated-field")
                .forEach(x => x.remove());

            let index = 0;
            let invalidMusic = false;

            document
                .querySelectorAll(".mass-part")
                .forEach(card => {

                    const massPart =
                        card.dataset.massPart;

                    card
                        .querySelectorAll(".music-search")
                        .forEach(input => {

                            const title =
                                input.value.trim();

                            if (!title) {
                                return;
                            }

                            const musicId =
                                input.dataset.musicId;

                            if (!musicId) {

                                input.classList.add("is-invalid");

                                invalidMusic = true;

                                return;
                            }

                            addHidden(
                                `Selections[${index}].MassPart`,
                                massPart
                            );

                            addHidden(
                                `Selections[${index}].SongId`,
                                musicId
                            );

                            addHidden(
                                `Selections[${index}].DisplayOrder`,
                                index + 1
                            );

                            index++;
                        });

                });


            if (invalidMusic) {

                event.preventDefault();

                alert(
                    "Please select music from the search results."
                );
            }

        });


        function addHidden(name, value) {

            const input =
                document.createElement("input");

            input.type = "hidden";
            input.name = name;
            input.value = value;
            input.className = "generated-field";

            form.appendChild(input);
        }
        const massPlanList = document.getElementById('massPlanList');

        if (massPlanList) {
            massPlanList.addEventListener('click', async function (event) {
                const upButton = event.target.closest('.move-up');
                const downButton = event.target.closest('.move-down');

                if (!upButton && !downButton) {
                    return;
                }

                const row = event.target.closest('.mass-plan-item');

                if (!row) {
                    return;
                }

                if (upButton) {
                    const previous = row.previousElementSibling;

                    if (!previous) {
                        return;
                    }

                    massPlanList.insertBefore(row, previous);
                }

                if (downButton) {
                    const next = row.nextElementSibling;

                    if (!next) {
                        return;
                    }

                    massPlanList.insertBefore(next, row);
                }

                updatePlanNumbers();
                await savePlanOrder();
            });
        }

        function updatePlanNumbers() {
            const rows = document.querySelectorAll(
                '#massPlanList .mass-plan-item'
            );

            rows.forEach((row, index) => {
                const number = row.querySelector('.plan-item-number');

                if (number) {
                    number.textContent = index + 1;
                }
            });
        }

        async function savePlanOrder() {
            const rows =
                massPlanList.querySelectorAll(
                    ".mass-plan-item"
                );

            const formData = new FormData();

            formData.append(
                "id",
                "@Model.Mass.Id"
            );

            rows.forEach(row => {
                formData.append(
                    "itemIds",
                    row.dataset.planItemId
                );
            });

            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );

            if (token) {
                formData.append(
                    "__RequestVerificationToken",
                    token.value
                );
            }

            try {
                const response = await fetch(
                    "?handler=SavePlanOrder",
                    {
                        method: "POST",
                        body: formData
                    }
                );

                if (!response.ok) {
                    console.error(
                        "SavePlanOrder failed:",
                        response.status,
                        await response.text()
                    );

                    alert(
                        "Unable to save presentation order."
                    );

                    return false;
                }

                return true;
            }
            catch (error) {
                console.error(
                    "SavePlanOrder error:",
                    error
                );

                alert(
                    "Unable to save presentation order."
                );

                return false;
            }
        }

                                                                                                                                                                                        });
    </script>
}