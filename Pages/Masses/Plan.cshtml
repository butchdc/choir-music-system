@page "{id:int}"
@model choir_music_system.Pages.Masses.PlanModel

@{
    ViewData["Title"] = "Plan Music";

    var massParts = new[]
    {
        "Entrance",
        "Kyrie",
        "Gloria",
        "Psalm",
        "Alleluia",
        "Offertory",
        "Holy",
        "Memorial Acclamation",
        "Amen",
        "Our Father",
        "Lamb of God",
        "Communion",
        "Recessional"
    };
}

<div class="mb-4">
    <h1>Plan Music</h1>

    <p class="text-muted mb-0">
        @Model.Mass.Name
        —
        @Model.Mass.MassDate.ToString("dd MMM yyyy")
    </p>
</div>

<form method="post" id="musicPlanForm">

    <div id="massParts">

        @foreach (var part in massParts)
        {
            var partSelections = Model.Selections
                .Where(x => x.MassPart == part)
                .OrderBy(x => x.DisplayOrder)
                .ToList();

            <div class="card mb-3 mass-part" data-mass-part="@part">

                <div class="card-body">

                    <h5 class="card-title mb-3">
                        @part
                    </h5>

                    <div class="music-rows">

                        @foreach (var selection in partSelections)
                        {
                            var selectedMusic = selection.SongId.HasValue
                                ? Model.Songs.FirstOrDefault(
                                    x => x.Id == selection.SongId.Value)
                                : null;

                            <div class="music-row d-flex gap-2 mb-2">

                                <div class="music-picker flex-grow-1 position-relative">

                                    <input type="text" class="form-control music-search"
                                           value="@(
                                           selectedMusic is null
                                               ? ""
                                               : string.Join(
                                                   " — ",
                                                   new[]
                                                   {
                                                                                                                                                                                     selectedMusic.Title,
                                                                                                                                                                                     selectedMusic.Composer,
                                                                                                                                                                                     string.IsNullOrWhiteSpace(selectedMusic.Arrangement)
                                                                                                                                                                                         ? null
                                                                                                                                                                                         : $"Arr: {selectedMusic.Arrangement}",
                                                                                                                                                                                     selectedMusic.SuggestedMassPart,
                                                                                                                                                                                     string.IsNullOrWhiteSpace(selectedMusic.Key)
                                                                                                                                                                                         ? null
                                                                                                                                                                                         : $"Key: {selectedMusic.Key}"
                                                   }
                                                   .Where(x => !string.IsNullOrWhiteSpace(x))
                                               )
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     )"
                                           data-music-id="@selectedMusic?.Id" placeholder="Search title, composer, part or key..."
                                           autocomplete="off" />

                                    <div class="music-results list-group position-absolute w-100 shadow"
                                         style="z-index: 1000; max-height: 250px; overflow-y: auto; display: none;">
                                    </div>

                                </div>

                                <a class="btn btn-outline-secondary view-music"
                                   href="@(selectedMusic is null
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ? "#"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    : $"/MusicLibrary/View/{selectedMusic.Id}")"
                                   target="_blank" rel="noopener noreferrer"
                                   style="@(selectedMusic is null ? "display:none;" : "")">
                                    View
                                </a>

                                <button type="button" class="btn btn-outline-danger remove-song">
                                    Remove
                                </button>

                            </div>
                        }

                    </div>

                    <button type="button" class="btn btn-sm btn-outline-primary add-song">
                        + Add another song
                    </button>

                </div>

            </div>
        }

    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">
            Save Music Plan
        </button>

        <a asp-page="Index" class="btn btn-secondary">
            Cancel
        </a>
    </div>

</form>

<hr class="my-5">

<div class="mb-4">
    <h3>Mass Presentation Order</h3>
    <p class="text-muted mb-0">
        Songs and presentation items will appear in this order in the PowerPoint.
    </p>
</div>

@if (Model.PlanItems.Count > 0)
{
    var orderedItems = Model.PlanItems
        .OrderBy(x => x.DisplayOrder)
        .ToList();

    <div class="card mb-4">
        <div class="list-group" id="massPlanList">

            @for (var i = 0; i < orderedItems.Count; i++)
            {
                var planItem = orderedItems[i];

                <div class="list-group-item mass-plan-item" data-plan-item-id="@planItem.Id">
                    <div class="d-flex align-items-center gap-3">

                        <div class="text-muted text-center" style="width: 35px;">
                            <span class="plan-item-number">
                                @(i + 1)
                            </span>
                        </div>

                        <div class="flex-grow-1">

                            @if (planItem.ItemType == "Song" &&
                                planItem.Song is not null)
                            {
                                <div class="fw-semibold">
                                    🎵 @planItem.Song.Title
                                </div>

                                <div class="small text-muted">
                                    @planItem.MassPart

                                    @if (!string.IsNullOrWhiteSpace(planItem.Song.Composer))
                                    {
                                        <span> · @planItem.Song.Composer</span>
                                    }
                                </div>
                            }
                            else if (planItem.ItemType == "Presentation")
                            {
                                @if (planItem.PresentationItem is not null)
                                {
                                    <a asp-page="/PresentationLibrary/Edit" asp-route-id="@planItem.PresentationItem.Id"
                                       asp-route-returnUrl="@($"{Request.Path}{Request.QueryString}")" class="text-decoration-none">
                                        @planItem.PresentationItem.Title
                                    </a>

                                    <div class="small text-muted">
                                        @if (!string.IsNullOrWhiteSpace(planItem.MassPart))
                                        {
                                            <span>@planItem.MassPart · </span>
                                        }

                                        @planItem.PresentationItem.Type
                                    </div>
                                }
                                else
                                {
                                    <div class="fw-semibold text-danger">
                                        📄 Presentation item unavailable
                                    </div>
                                }
                            }

                        </div>

                        <div class="d-flex gap-1">

                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary move-up" title="Move up">
                                    ↑
                                </button>

                                <button type="button" class="btn btn-sm btn-outline-secondary move-down" title="Move down">
                                    ↓
                                </button>
                            </div>

                            @if (planItem.ItemType == "Presentation")
                            {
                                <form method="post" asp-page-handler="RemovePlanItem">

                                    <input type="hidden" name="id" value="@Model.Mass.Id" />

                                    <input type="hidden" name="planItemId" value="@planItem.Id" />

                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Remove
                                    </button>
                                </form>
                            }

                        </div>

                    </div>
                </div>
            }

        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-body">

        <h5 class="card-title">
            Add Presentation Item
        </h5>

        <form method="post" asp-page-handler="AddPresentation">

            <input type="hidden" name="id" value="@Model.Mass.Id" />

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">
                        Presentation Item
                    </label>

                    <select name="presentationItemId" class="form-select" required>

                        <option value="">
                            Select presentation item...
                        </option>

                        @foreach (var item in Model.PresentationLibrary)
                        {
                            <option value="@item.Id">
                                @item.Type - @item.Title
                            </option>
                        }

                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        Mass Part
                    </label>

                    <select name="massPart" class="form-select">

                        <option value="">Not specified</option>

                        @foreach (var part in massParts)
                        {
                            <option value="@part">
                                @part
                            </option>
                        }

                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        Add
                    </button>
                </div>

            </div>

        </form>

    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("musicPlanForm");

            const musicLibrary = [
                                                                                                                        @foreach (var music in Model.Songs)
                {
                    @:{
                                                                                                                                                                                                                                    @:id: @music.Id,
                    @:title: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(music.Title))",
                    @:composer: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(music.Composer ?? ""))",
                    @:arrangement: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(music.Arrangement ?? ""))",
                    @:suggestedPart: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(music.SuggestedMassPart ?? ""))",
                    @:key: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(music.Key ?? ""))"
                                                                                                                                                                                                                                    @:},
            }
                                                                                                                    ];

        function createMusicRow() {

            const row = document.createElement("div");

            row.className = "music-row d-flex gap-2 mb-2";

            row.innerHTML = `
                                                                                                <div class="music-picker flex-grow-1 position-relative">

                                                                                                    <input type="text"
                                                                                                           class="form-control music-search"
                                                                                                           data-music-id=""
                                                                                                           placeholder="Search title, composer, part or key..."
                                                                                                           autocomplete="off" />

                                                                                                    <div class="music-results list-group position-absolute w-100 shadow"
                                                                                                         style="z-index: 1000; max-height: 250px; overflow-y: auto; display: none;">
                                                                                                    </div>

                                                                                                </div>

                                                                                                <a class="btn btn-outline-secondary view-music"
                                                                                                   href="#"
                                                                                                   target="_blank"
                                                                                                   style="display:none;">
                                                                                                    View
                                                                                                </a>

                                                                                                <button type="button"
                                                                                                        class="btn btn-outline-danger remove-song">
                                                                                                    Remove
                                                                                                </button>
                                                                                            `;

            return row;
        }


        document.addEventListener("input", function (event) {

            if (!event.target.classList.contains("music-search")) {
                return;
            }

            const input = event.target;

            const picker =
                input.closest(".music-picker");

            const results =
                picker.querySelector(".music-results");

            const search =
                input.value.toLowerCase().trim();

            input.dataset.musicId = "";
            input.classList.remove("is-invalid");

            results.innerHTML = "";

            if (!search) {
                results.style.display = "none";
                return;
            }

            const massPart =
                input.closest(".mass-part").dataset.massPart;

            const matches = musicLibrary
                .filter(music => {

                    const searchableText = [
                        music.title,
                        music.composer,
                        music.arrangement,
                        music.suggestedPart,
                        music.key
                    ]
                        .join(" ")
                        .toLowerCase();

                    return searchableText.includes(search);
                })
                .sort((a, b) => {

                    const aExactTitle =
                        a.title.toLowerCase() === search;

                    const bExactTitle =
                        b.title.toLowerCase() === search;

                    if (aExactTitle !== bExactTitle) {
                        return aExactTitle ? -1 : 1;
                    }

                    const aTitleStarts =
                        a.title.toLowerCase().startsWith(search);

                    const bTitleStarts =
                        b.title.toLowerCase().startsWith(search);

                    if (aTitleStarts !== bTitleStarts) {
                        return aTitleStarts ? -1 : 1;
                    }

                    const aSuggested =
                        a.suggestedPart.toLowerCase() ===
                        massPart.toLowerCase();

                    const bSuggested =
                        b.suggestedPart.toLowerCase() ===
                        massPart.toLowerCase();

                    if (aSuggested !== bSuggested) {
                        return aSuggested ? -1 : 1;
                    }

                    return a.title.localeCompare(b.title);
                })
                .slice(0, 15);

            if (matches.length === 0) {
                results.style.display = "none";
                return;
            }

            matches.forEach(music => {

                const item =
                    document.createElement("button");

                item.type = "button";

                item.className =
                    "list-group-item list-group-item-action";

                const title =
                    document.createElement("div");

                title.className = "fw-semibold";
                title.textContent = music.title;

                const details =
                    document.createElement("div");

                details.className = "small text-muted";

                const detailParts = [];

                if (music.composer) {
                    detailParts.push(music.composer);
                }

                if (music.arrangement) {
                    detailParts.push(`Arr: ${music.arrangement}`);
                }

                if (music.suggestedPart) {
                    detailParts.push(music.suggestedPart);
                }

                if (music.key) {
                    detailParts.push(`Key: ${music.key}`);
                }

                details.textContent =
                    detailParts.join(" • ");

                item.appendChild(title);

                if (detailParts.length > 0) {
                    item.appendChild(details);
                }

                item.addEventListener("click", function () {

                    const selectedDetails = [];

                    selectedDetails.push(music.title);

                    if (music.composer) {
                        selectedDetails.push(music.composer);
                    }

                    if (music.arrangement) {
                        selectedDetails.push(`Arr: ${music.arrangement}`);
                    }

                    if (music.suggestedPart) {
                        selectedDetails.push(music.suggestedPart);
                    }

                    if (music.key) {
                        selectedDetails.push(`Key: ${music.key}`);
                    }

                    input.value = selectedDetails.join(" — ");
                    input.dataset.musicId = music.id;
                    const row =
                        input.closest(".music-row");

                    const viewButton =
                        row.querySelector(".view-music");

                    viewButton.href =
                        `/MusicLibrary/View/${music.id}`;

                    viewButton.style.display = "";

                    results.style.display = "none";
                });

                results.appendChild(item);
            });

            results.style.display = "block";
        });


        document.addEventListener("click", function (event) {

            const addButton =
                event.target.closest(".add-song");

            if (addButton) {

                const card =
                    addButton.closest(".mass-part");

                const rows =
                    card.querySelector(".music-rows");

                const newRow = createMusicRow();

                rows.appendChild(newRow);

                newRow
                    .querySelector(".music-search")
                    .focus();

                return;
            }


            const removeButton =
                event.target.closest(".remove-song");

            if (removeButton) {

                const card =
                    removeButton.closest(".mass-part");

                const rows =
                    card.querySelector(".music-rows");

                const row =
                    removeButton.closest(".music-row");

                if (
                    rows.querySelectorAll(".music-row").length > 1
                ) {
                    row.remove();
                }
                else {
                    const input =
                        row.querySelector(".music-search");

                    input.value = "";
                    input.dataset.musicId = "";
                    const viewButton =
                        row.querySelector(".view-music");

                    viewButton.href = "#";
                    viewButton.style.display = "none";
                }

                return;
            }


            if (!event.target.closest(".music-picker")) {
                document
                    .querySelectorAll(".music-results")
                    .forEach(results => {
                        results.style.display = "none";
                    });
            }

        });


        form.addEventListener("submit", function (event) {

            form.querySelectorAll(".generated-field")
                .forEach(x => x.remove());

            let index = 0;
            let invalidMusic = false;

            document
                .querySelectorAll(".mass-part")
                .forEach(card => {

                    const massPart =
                        card.dataset.massPart;

                    card
                        .querySelectorAll(".music-search")
                        .forEach(input => {

                            const title =
                                input.value.trim();

                            if (!title) {
                                return;
                            }

                            const musicId =
                                input.dataset.musicId;

                            if (!musicId) {

                                input.classList.add("is-invalid");

                                invalidMusic = true;

                                return;
                            }

                            addHidden(
                                `Selections[${index}].MassPart`,
                                massPart
                            );

                            addHidden(
                                `Selections[${index}].SongId`,
                                musicId
                            );

                            addHidden(
                                `Selections[${index}].DisplayOrder`,
                                index + 1
                            );

                            index++;
                        });

                });


            if (invalidMusic) {

                event.preventDefault();

                alert(
                    "Please select music from the search results."
                );
            }

        });


        function addHidden(name, value) {

            const input =
                document.createElement("input");

            input.type = "hidden";
            input.name = name;
            input.value = value;
            input.className = "generated-field";

            form.appendChild(input);
        }
        const massPlanList = document.getElementById('massPlanList');

        if (massPlanList) {
            massPlanList.addEventListener('click', async function (event) {
                const upButton = event.target.closest('.move-up');
                const downButton = event.target.closest('.move-down');

                if (!upButton && !downButton) {
                    return;
                }

                const row = event.target.closest('.mass-plan-item');

                if (!row) {
                    return;
                }

                if (upButton) {
                    const previous = row.previousElementSibling;

                    if (!previous) {
                        return;
                    }

                    massPlanList.insertBefore(row, previous);
                }

                if (downButton) {
                    const next = row.nextElementSibling;

                    if (!next) {
                        return;
                    }

                    massPlanList.insertBefore(next, row);
                }

                updatePlanNumbers();
                await savePlanOrder();
            });
        }

        function updatePlanNumbers() {
            const rows = document.querySelectorAll(
                '#massPlanList .mass-plan-item'
            );

            rows.forEach((row, index) => {
                const number = row.querySelector('.plan-item-number');

                if (number) {
                    number.textContent = index + 1;
                }
            });
        }

        async function savePlanOrder() {
            const rows =
                massPlanList.querySelectorAll(
                    ".mass-plan-item"
                );

            const formData = new FormData();

            formData.append(
                "id",
                "@Model.Mass.Id"
            );

            rows.forEach(row => {
                formData.append(
                    "itemIds",
                    row.dataset.planItemId
                );
            });

            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );

            if (token) {
                formData.append(
                    "__RequestVerificationToken",
                    token.value
                );
            }

            try {
                const response = await fetch(
                    "?handler=SavePlanOrder",
                    {
                        method: "POST",
                        body: formData
                    }
                );

                if (!response.ok) {
                    console.error(
                        "SavePlanOrder failed:",
                        response.status,
                        await response.text()
                    );

                    alert(
                        "Unable to save presentation order."
                    );

                    return false;
                }

                return true;
            }
            catch (error) {
                console.error(
                    "SavePlanOrder error:",
                    error
                );

                alert(
                    "Unable to save presentation order."
                );

                return false;
            }
        }

                                                                                                                });
    </script>
}