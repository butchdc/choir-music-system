@page
@model choir_music_system.Pages.Masses.CreateModel

@{
    ViewData["Title"] = "Create Mass";
}

<div class="create-mass-page">

    <div class="create-mass-header">

        <div class="create-mass-header-main">

            <a asp-page="Index"
               class="btn btn-sm create-mass-back">
                <i class="bi bi-arrow-left"></i>
                Masses
            </a>

            <div class="create-mass-heading">

                <div class="create-mass-icon">
                    <i class="bi bi-calendar2-plus"></i>
                </div>

                <div>
                    <div class="create-mass-kicker">
                        Mass Planning
                    </div>

                    <h1>Create Mass</h1>

                    <p>
                        Set up the Mass details, then continue
                        to music and presentation planning.
                    </p>
                </div>

            </div>

        </div>

    </div>


    <form method="post"
          enctype="multipart/form-data"
          class="create-mass-form">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <div class="create-mass-grid">

            <div class="create-mass-main">


                <section class="create-mass-card">

                    <div class="create-mass-card-header">

                        <div class="create-mass-card-icon">
                            <i class="bi bi-calendar-event"></i>
                        </div>

                        <div>
                            <h2>Mass Details</h2>
                            <p>
                                Give this Mass a name, date and venue.
                            </p>
                        </div>

                    </div>


                    <div class="create-mass-fields">

                        <div class="create-mass-field create-mass-field-wide">

                            <label asp-for="Mass.Name"
                                   class="form-label">
                                Mass Name
                            </label>

                            <input asp-for="Mass.Name"
                                   class="form-control form-control-lg"
                                   placeholder="e.g. Sunday Mass" />

                            <span asp-validation-for="Mass.Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="create-mass-field">
                            <label asp-for="Mass.MassDate"
                                class="form-label">
                                Mass Date &amp; Time
                            </label>

                            <div class="create-mass-input-icon">

                                <i class="bi bi-calendar-event"></i>

                                <input asp-for="Mass.MassDate"
                                    type="datetime-local"
                                    class="form-control"
                                    step="900" />

                            </div>

                            <span asp-validation-for="Mass.MassDate"
                                class="text-danger">
                            </span>
                        </div>


                        <div class="create-mass-field">

                            <label asp-for="Mass.Venue"
                                   class="form-label">
                                Venue
                            </label>

                            <div class="create-mass-input-icon">

                                <i class="bi bi-geo-alt"></i>

                                <input asp-for="Mass.Venue"
                                       class="form-control"
                                       placeholder="e.g. Holy Cross" />

                            </div>

                            <span asp-validation-for="Mass.Venue"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </section>


                <section class="create-mass-card">

                    <div class="create-mass-card-header">

                        <div class="create-mass-card-icon">
                            <i class="bi bi-chat-left-text"></i>
                        </div>

                        <div>
                            <h2>Mass Introduction</h2>
                            <p>
                                Introduction displayed on the opening
                                Mass slide in the presentation.
                            </p>
                        </div>

                    </div>


                    <div class="create-mass-field">

                        <textarea asp-for="Mass.MassIntroduction"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Enter the introduction for this Mass..."></textarea>

                        <span asp-validation-for="Mass.MassIntroduction"
                              class="text-danger">
                        </span>

                        <div class="create-mass-help">

                            <i class="bi bi-easel2"></i>

                            <span>
                                This will be used as the subtitle
                                on the Mass title slide.
                            </span>

                        </div>

                    </div>

                </section>


                <section class="create-mass-card">

                    <div class="create-mass-card-header">

                        <div class="create-mass-card-icon">
                            <i class="bi bi-layers"></i>
                        </div>

                        <div>
                            <h2>Start Your Plan</h2>
                            <p>
                                Start fresh or use one of your
                                saved Mass templates.
                            </p>
                        </div>

                    </div>


                    <div class="create-mass-field">

                        <label asp-for="MassTemplateId"
                               class="form-label">
                            Mass Template
                        </label>

                        <select asp-for="MassTemplateId"
                                class="form-select form-select-lg">

                            <option value="">
                                Start from scratch
                            </option>

                            @foreach (var template in Model.MassTemplates)
                            {
                                <option value="@template.Id">
                                    @template.Name
                                </option>
                            }

                        </select>

                        <div class="create-mass-help">

                            <i class="bi bi-info-circle"></i>

                            <span>
                                Using a template automatically adds
                                its saved songs and presentation items
                                to the new Mass.
                            </span>

                        </div>

                        <span asp-validation-for="MassTemplateId"
                              class="text-danger">
                        </span>

                    </div>

                </section>


                <section class="create-mass-card">

                    <div class="create-mass-card-header">

                        <div class="create-mass-card-icon">
                            <i class="bi bi-journal-text"></i>
                        </div>

                        <div>
                            <h2>Internal Notes</h2>
                            <p>
                                Planning notes for your team.
                                These are not shown in the presentation.
                            </p>
                        </div>

                    </div>


                    <div class="create-mass-field">

                        <textarea asp-for="Mass.Notes"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Optional internal notes for this Mass..."></textarea>

                        <span asp-validation-for="Mass.Notes"
                              class="text-danger">
                        </span>

                    </div>

                </section>

            </div>


            <aside class="create-mass-sidebar">

                <section class="create-mass-card create-background-card">

                    <div class="create-mass-card-header">

                        <div class="create-mass-card-icon">
                            <i class="bi bi-image"></i>
                        </div>

                        <div>
                            <h2>Presentation</h2>
                            <p>
                                Optional PowerPoint background.
                            </p>
                        </div>

                    </div>


                    <div class="create-background-upload">

                        <div class="create-background-placeholder">

                            <i class="bi bi-image"></i>

                            <strong>
                                Presentation Background
                            </strong>

                            <span>
                                JPG or PNG · Maximum 10 MB
                            </span>

                        </div>


                        <div class="app-file-picker">

                            <input asp-for="BackgroundImage"
                                type="file"
                                accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                                class="app-file-picker-input" />

                            <label for="BackgroundImage"
                                class="app-file-picker-button">
                                Choose File
                            </label>

                            <span class="app-file-picker-name">
                                No file selected
                            </span>

                        </div>

                        <span asp-validation-for="BackgroundImage"
                              class="text-danger">
                        </span>

                    </div>

                </section>


                <div class="create-mass-next">

                    <div class="create-mass-next-icon">
                        <i class="bi bi-music-note-list"></i>
                    </div>

                    <div>
                        <strong>What happens next?</strong>

                        <p>
                            After creating the Mass you'll go
                            directly to the Mass Plan to select
                            songs and presentation items.
                        </p>
                    </div>

                </div>

            </aside>

        </div>


        <div class="create-mass-actions">

            <div class="create-mass-actions-info">

                <i class="bi bi-check2-circle"></i>

                <span>
                    You can change these details later.
                </span>

            </div>


            <div class="create-mass-actions-buttons">

                <a asp-page="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-warning create-mass-submit">

                    <i class="bi bi-arrow-right-circle me-1"></i>
                    Create &amp; Plan Mass

                </button>

            </div>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}