@page
@model choir_music_system.Pages.Account.EmergencyModel
@{
    ViewData["Title"] = "Emergency Admin";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h1 class="h4 mb-2">
                        Emergency Admin
                    </h1>

                    <p class="text-muted mb-4">
                        Break-glass access for emergency administration only.
                    </p>

                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Username"
                                   class="form-label">
                                Username
                            </label>

                            <input asp-for="Username"
                                   class="form-control"
                                   autocomplete="username" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   autocomplete="current-password" />
                        </div>

                        <button type="submit"
                                class="btn btn-danger w-100">
                            Emergency Sign In
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>