@page
@model choir_music_system.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="container py-4">

    <div class="row justify-content-center align-items-start g-4">

        <!-- LOGIN -->
        <div class="col-lg-5">

            <div class="card shadow-sm login-card">

                <div class="card-body p-4 text-center">

                    <img src="~/images/choir-logo.png"
                         alt="Choir Music System"
                         class="login-logo" />

                    <div class="login-welcome text-start">

                        <h2>Welcome</h2>

                        <p>
                            Music planning and resources for our choir community.
                        </p>

                        <p>
                            Choir members can sign in to access music,
                            Mass plans and presentation resources.
                        </p>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger text-start">
                            @Model.ErrorMessage
                        </div>
                    }

                    <form method="post"
                          asp-page-handler="Google"
                          class="mt-3">

                        <button type="submit"
                                class="google-signin-button">

                            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                                 alt=""
                                 class="google-signin-icon" />

                            <span>Sign in with Google</span>

                        </button>

                    </form>

                    <div class="login-invite-note">
                        <i class="bi bi-lock-fill"></i>
                        Invited members only
                    </div>

                </div>

            </div>

        </div>


        <!-- UPCOMING MASSES -->
        <div class="col-lg-7">

            <div class="card shadow-sm public-masses-card">

                <div class="card-body p-4">

                    <div class="mb-4">

                        <h2 class="h5 mb-1">
                            <i class="bi bi-calendar-event me-2"></i>
                            Upcoming Masses
                        </h2>

                        <p class="text-muted small mb-0">
                            Join us at our upcoming Masses
                        </p>

                    </div>


                    @if (Model.UpcomingMasses.Count > 0)
                    {
                        <div class="public-mass-list">

                            @foreach (var mass in Model.UpcomingMasses)
                            {
                                <div class="public-mass-item">

                                    <div class="public-mass-date">

                                        <span class="public-mass-day">
                                            @mass.MassDate.ToString("dd")
                                        </span>

                                        <span class="public-mass-month">
                                            @mass.MassDate.ToString("MMM")
                                        </span>

                                    </div>


                                    <div class="public-mass-details">

                                        <div class="public-mass-name">
                                            @mass.Name
                                        </div>

                                        <div class="public-mass-time">
                                            <i class="bi bi-clock me-1"></i>
                                            @mass.MassDate.ToString("h:mm tt")
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(mass.Venue))
                                        {
                                            <div class="public-mass-venue">
                                                <i class="bi bi-geo-alt me-1"></i>
                                                @mass.Venue
                                            </div>
                                        }

                                        <div class="public-mass-full-date">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            @mass.MassDate.ToString(
                                                "dddd, d MMMM yyyy")
                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-muted text-center py-4">
                            No upcoming Masses scheduled.
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>