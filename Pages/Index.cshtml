@page
@model IndexModel

@{
    ViewData["Title"] = "Home";
}

<!-- DASHBOARD HERO -->

<div class="dashboard-hero mb-4">

    <div class="dashboard-hero-decoration dashboard-hero-decoration-one">
        <i class="bi bi-music-note-beamed"></i>
    </div>

    <div class="dashboard-hero-decoration dashboard-hero-decoration-two">
        <i class="bi bi-music-note"></i>
    </div>

    <div class="dashboard-hero-content">

        <div class="dashboard-hero-kicker">
            <i class="bi bi-music-note-beamed"></i>
            Choir Workspace
        </div>

        <h1>
            Welcome to your
            <span>Choir Music System</span>
        </h1>

        <p>
            Plan Masses, organise your music library, and prepare
            everything your choir needs for worship.
        </p>

        <div class="dashboard-hero-actions">

            <a asp-page="/Masses/Create"
               class="btn dashboard-hero-primary">

                <i class="bi bi-calendar-plus"></i>
                Create Mass

            </a>

            <a asp-page="/MusicLibrary/Index"
               class="btn dashboard-hero-secondary">

                <i class="bi bi-music-note-list"></i>
                Browse Music

            </a>

        </div>

    </div>


    <div class="dashboard-hero-graphic"
         aria-hidden="true">

        <div class="hero-music-circle">

            <svg viewBox="0 0 240 240">

                <circle cx="120"
                        cy="120"
                        r="94"
                        class="hero-circle-ring" />

                <circle cx="120"
                        cy="120"
                        r="75"
                        class="hero-circle-inner" />

                <!-- music staff -->

                <path class="hero-staff"
                      d="M55 105h130
                      M55 119h130
                      M55 133h130
                      M55 147h130" />

                <!-- main musical note -->

                <path class="hero-note"
                      d="M119 61v73
                      c-8-5-20-4-28 2
                      c-10 7-12 18-5 24
                      c7 7 21 6 31-1
                      c8-6 11-13 11-22
                      V86
                      l45-12
                      v47
                      c-8-5-20-4-28 2
                      c-10 7-12 18-5 24
                      c7 7 21 6 31-1
                      c8-6 11-13 11-22
                      V57
                      z" />

                <!-- small cross -->

                <path class="hero-cross"
                      d="M75 64v27M64 75h22" />

            </svg>

        </div>

    </div>

</div>


<!-- SUMMARY CARDS -->

<div class="row g-3 mb-4">

    <div class="col-6 col-lg-3">

        <a asp-page="/MusicLibrary/Index"
           class="metric-card metric-card-music">

            <div>

                <div class="metric-label">
                    Songs
                </div>

                <div class="metric-value">
                    @Model.SongCount
                </div>

                <div class="small text-muted mt-1">
                    Music Library
                </div>

            </div>

            <div class="metric-icon">
                <i class="bi bi-music-note-beamed"></i>
            </div>

        </a>

    </div>


    <div class="col-6 col-lg-3">

        <a asp-page="/Masses/Index"
           asp-route-filter="upcoming"
           class="metric-card metric-card-mass">

            <div>

                <div class="metric-label">
                    Upcoming Masses
                </div>

                <div class="metric-value">
                    @Model.UpcomingMassCount
                </div>

                <div class="small text-muted mt-1">

                    @if (Model.NextMass is not null)
                    {
                        <span>
                            Next @Model.NextMass.MassDate.ToString("dd MMM")
                        </span>
                    }
                    else
                    {
                        <span>
                            Nothing scheduled
                        </span>
                    }

                </div>

            </div>

            <div class="metric-icon">
                <i class="bi bi-calendar-check"></i>
            </div>

        </a>

    </div>


    <div class="col-6 col-lg-3">

        <a asp-page="/MassTemplates/Index"
           class="metric-card metric-card-template">

            <div>

                <div class="metric-label">
                    Mass Templates
                </div>

                <div class="metric-value">
                    @Model.MassTemplateCount
                </div>

                <div class="small text-muted mt-1">
                    Reusable Mass plans
                </div>

            </div>

            <div class="metric-icon">
                <i class="bi bi-layers"></i>
            </div>

        </a>

    </div>


    <div class="col-6 col-lg-3">

        <a asp-page="/MusicLibrary/Index"
           asp-route-filter="needs-attention"
           class="metric-card metric-card-attention">

            <div>

                <div class="metric-label">
                    Needs Attention
                </div>

                <div class="metric-value">
                    @Model.NeedsAttentionCount
                </div>

                <div class="small text-muted mt-1">
                    Incomplete songs
                </div>

            </div>

            <div class="metric-icon">
                <i class="bi bi-exclamation-circle"></i>
            </div>

        </a>

    </div>

</div>


<!-- QUICK START -->

<div class="dashboard-section-heading">

    <div>
        <h2>Quick Start</h2>
        <p>Jump straight into your most common tasks.</p>
    </div>

</div>


<div class="row g-3 mb-4">

    <div class="col-md-4">

        <a asp-page="/Masses/Create"
           class="quick-action quick-action-mass">

            <span class="quick-action-icon">
                <i class="bi bi-calendar-plus"></i>
            </span>

            <span class="quick-action-content">

                <strong>
                    Create Mass
                </strong>

                <small>
                    Start planning a new Mass
                </small>

            </span>

            <i class="bi bi-arrow-right quick-action-arrow"></i>

        </a>

    </div>


    <div class="col-md-4">

        <a asp-page="/MusicLibrary/Create"
           class="quick-action quick-action-song">

            <span class="quick-action-icon">
                <i class="bi bi-music-note-beamed"></i>
            </span>

            <span class="quick-action-content">

                <strong>
                    Add Song
                </strong>

                <small>
                    Add music to your library
                </small>

            </span>

            <i class="bi bi-arrow-right quick-action-arrow"></i>

        </a>

    </div>


    <div class="col-md-4">

        <a asp-page="/MassTemplates/Create"
           class="quick-action quick-action-template">

            <span class="quick-action-icon">
                <i class="bi bi-layers"></i>
            </span>

            <span class="quick-action-content">

                <strong>
                    Create Template
                </strong>

                <small>
                    Build a reusable Mass plan
                </small>

            </span>

            <i class="bi bi-arrow-right quick-action-arrow"></i>

        </a>

    </div>

</div>


<!-- NEXT MASS -->

@if (Model.NextMass is not null)
{
    <div class="next-mass-card mb-4">

        <div class="next-mass-accent"></div>


        <div class="next-mass-date">

            <span class="next-mass-date-month">
                @Model.NextMass.MassDate.ToString("MMM")
            </span>

            <span class="next-mass-date-day">
                @Model.NextMass.MassDate.ToString("dd")
            </span>

            <span class="next-mass-date-year">
                @Model.NextMass.MassDate.ToString("yyyy")
            </span>

        </div>


        <div class="next-mass-main">

            <div class="next-mass-eyebrow">

                <i class="bi bi-calendar-check"></i>

                Next Mass

            </div>


            <h2>
                @Model.NextMass.Name
            </h2>


            @if (!string.IsNullOrWhiteSpace(Model.NextMass.Venue))
            {
                <div class="next-mass-venue">

                    <i class="bi bi-geo-alt-fill"></i>

                    <span>
                        @Model.NextMass.Venue
                    </span>

                </div>
            }
            else
            {
                <div class="next-mass-venue is-missing">

                    <i class="bi bi-geo-alt"></i>

                    <span>
                        Venue not set
                    </span>

                </div>
            }


            <div class="next-mass-full-date">

                <i class="bi bi-calendar3 me-1"></i>

                @Model.NextMass.MassDate.ToString(
                    "dddd, d MMMM yyyy"
                )

                <span class="mx-2">•</span>

                <i class="bi bi-clock me-1"></i>

                @Model.NextMass.MassDate.ToString(
                    "h:mm tt"
                )

            </div>


            <div class="next-mass-status">

                <span>

                    <i class="bi bi-music-note-list"></i>

                    <strong>
                        @Model.NextMass.MusicCount
                    </strong>

                    song@(Model.NextMass.MusicCount == 1 ? "" : "s")

                </span>


                <span>

                    <i class="bi bi-easel2"></i>

                    <strong>
                        @Model.NextMass.PresentationItemCount
                    </strong>

                    presentation item@(Model.NextMass.PresentationItemCount == 1 ? "" : "s")

                </span>


                <span class="@(Model.NextMass.HasBackground
                    ? "is-ready"
                    : "is-missing")">

                    <i class="bi @(Model.NextMass.HasBackground
                        ? "bi-check-circle"
                        : "bi-image")"></i>

                    @(Model.NextMass.HasBackground
                        ? "Background ready"
                        : "No background")

                </span>

            </div>

        </div>


        <div class="next-mass-actions">

            <a asp-page="/Masses/Plan"
               asp-route-id="@Model.NextMass.Id"
               class="btn btn-primary">

                <i class="bi bi-music-note-list"></i>

                Plan Mass

            </a>


            @if (Model.NextMass.MusicCount > 0)
            {
                <a asp-page="/Masses/MusicPack"
                   asp-route-id="@Model.NextMass.Id"
                   class="btn btn-outline-secondary"
                   title="Generate Music Pack"
                   data-bs-toggle="tooltip">

                    <i class="bi bi-file-earmark-pdf"></i>

                    <span class="next-mass-action-label">
                        Music Pack
                    </span>

                </a>


                <a asp-page="/Masses/Index"
                   asp-page-handler="GeneratePpt"
                   asp-route-id="@Model.NextMass.Id"
                   class="btn btn-outline-secondary"
                   title="Generate PowerPoint"
                   data-bs-toggle="tooltip">

                    <i class="bi bi-file-earmark-slides"></i>

                    <span class="next-mass-action-label">
                        PowerPoint
                    </span>

                </a>

                @if (Model.NextMass.HasFinalPresentation)
                {
                    <a asp-page="/Masses/Plan"
                    asp-page-handler="DownloadFinalPresentation"
                    asp-route-id="@Model.NextMass.Id"
                    class="btn btn-outline-secondary"
                    title="Download Final Presentation"
                    data-bs-toggle="tooltip">

                        <i class="bi bi-file-earmark-check"></i>

                        <span class="next-mass-action-label">
                            Final PPT
                        </span>

                    </a>
                }
            }

        </div>


        <div class="next-mass-watermark"
             aria-hidden="true">

            <i class="bi bi-music-note-beamed"></i>

        </div>

    </div>
}
else
{
    <div class="next-mass-empty mb-4">

        <div class="next-mass-empty-icon">
            <i class="bi bi-calendar-plus"></i>
        </div>

        <div>

            <h3>
                No upcoming Masses
            </h3>

            <p>
                Create your next Mass and start building the music plan.
            </p>

        </div>

        <a asp-page="/Masses/Create"
           class="btn btn-primary ms-lg-auto">

            <i class="bi bi-plus-lg me-1"></i>

            Create Mass

        </a>

    </div>
}



<!-- CHARTS -->

<div class="row g-3 mb-4">

    <!-- LIBRARY READINESS -->

    <div class="col-lg-6">

        <div class="dashboard-panel h-100">

            <div class="dashboard-panel-header">

                <div>

                    <h5>
                        Library Readiness
                    </h5>

                    <span>
                        Click a bar to review missing information
                    </span>

                </div>


                <a asp-page="/MusicLibrary/Index"
                   class="dashboard-panel-link">

                    Review

                </a>

            </div>


            <div class="p-4">

                <div style="height: 320px;">
                    <canvas id="libraryReadinessChart"></canvas>
                </div>

            </div>

        </div>

    </div>


    <!-- MASS PART BREAKDOWN -->

    <div class="col-lg-6">

        <div class="dashboard-panel h-100">

            <div class="dashboard-panel-header">

                <div>

                    <h5>
                        Songs by Mass Part
                    </h5>

                    <span>
                        Click a bar to view those songs
                    </span>

                </div>


                <a asp-page="/MusicLibrary/Index"
                   class="dashboard-panel-link">

                    Library

                </a>

            </div>


            <div class="p-4">

                <div style="height: 320px;">
                    <canvas id="massPartChart"></canvas>
                </div>

            </div>

        </div>

    </div>

</div>


<!-- UPCOMING MASSES + RECENT MUSIC -->

<div class="dashboard-section-heading">

    <div>
        <h2>Coming Up</h2>
        <p>Your upcoming Masses and latest library activity.</p>
    </div>

</div>


<div class="row g-3 mb-4">

    <!-- UPCOMING MASSES -->

    <div class="col-lg-7">

        <div class="dashboard-panel dashboard-activity-panel h-100">

            <div class="dashboard-panel-header">

                <div class="dashboard-panel-title">

                    <span class="dashboard-panel-icon panel-icon-mass">
                        <i class="bi bi-calendar3"></i>
                    </span>

                    <div>

                        <h5>
                            Upcoming Masses
                        </h5>

                        <span>
                            Scheduled Masses and planning progress
                        </span>

                    </div>

                </div>


                <a asp-page="/Masses/Index"
                   class="dashboard-panel-link">

                    View all

                </a>

            </div>


            @if (Model.UpcomingMasses.Count == 0)
            {
                <div class="dashboard-empty">

                    <i class="bi bi-calendar"></i>

                    <div>

                        <strong>
                            No upcoming Masses
                        </strong>

                        <p>
                            Create a Mass when you're ready to start planning.
                        </p>

                    </div>

                </div>
            }
            else
            {
                <div class="dashboard-list">

                    @foreach (var mass in Model.UpcomingMasses)
                    {
                        <div class="dashboard-list-item dashboard-mass-item">

                            <div class="dashboard-date">

                                <span class="dashboard-date-day">
                                    @mass.MassDate.ToString("dd")
                                </span>

                                <span class="dashboard-date-month">
                                    @mass.MassDate.ToString("MMM")
                                </span>

                            </div>


                            <div class="dashboard-list-content">

                                <a asp-page="/Masses/Plan"
                                   asp-route-id="@mass.Id"
                                   class="dashboard-item-title">

                                    @mass.Name

                                </a>


                                @if (!string.IsNullOrWhiteSpace(mass.Venue))
                                {
                                    <div class="dashboard-mass-venue">

                                        <i class="bi bi-geo-alt-fill"></i>

                                        <span>
                                            @mass.Venue
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <div class="dashboard-mass-venue is-missing">

                                        <i class="bi bi-geo-alt"></i>

                                        <span>
                                            Venue not set
                                        </span>

                                    </div>
                                }
                                <div class="dashboard-mass-time">

                                    <i class="bi bi-clock"></i>

                                    <span>
                                        @mass.MassDate.ToString("h:mm tt")
                                    </span>

                                </div>

                                <div class="dashboard-list-meta">

                                    <span>

                                        <i class="bi bi-music-note-beamed"></i>

                                        @mass.MusicCount
                                        song@(mass.MusicCount == 1 ? "" : "s")

                                    </span>


                                    <span>

                                        <i class="bi bi-easel2"></i>

                                        @mass.PresentationItemCount
                                        item@(mass.PresentationItemCount == 1 ? "" : "s")

                                    </span>


                                    @if (mass.HasBackground)
                                    {
                                        <span class="dashboard-ready">

                                            <i class="bi bi-check-circle-fill"></i>

                                            Background

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="dashboard-warning">

                                            <i class="bi bi-image"></i>

                                            No background

                                        </span>
                                    }

                                </div>

                            </div>


                            <div class="dashboard-list-actions">

                                <a asp-page="/Masses/Plan"
                                   asp-route-id="@mass.Id"
                                   class="btn btn-sm btn-outline-primary table-action"
                                   title="Plan Mass"
                                   data-bs-toggle="tooltip">

                                    <i class="bi bi-music-note-list"></i>

                                </a>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>


    <!-- RECENT MUSIC -->

    <div class="col-lg-5">

        <div class="dashboard-panel dashboard-activity-panel h-100">

            <div class="dashboard-panel-header">

                <div class="dashboard-panel-title">

                    <span class="dashboard-panel-icon panel-icon-music">
                        <i class="bi bi-music-note-beamed"></i>
                    </span>

                    <div>

                        <h5>
                            Recently Updated Music
                        </h5>

                        <span>
                            Latest changes in your library
                        </span>

                    </div>

                </div>


                <a asp-page="/MusicLibrary/Index"
                   class="dashboard-panel-link">

                    Library

                </a>

            </div>


            @if (Model.RecentMusic.Count == 0)
            {
                <div class="dashboard-empty">

                    <i class="bi bi-music-note"></i>

                    <div>

                        <strong>
                            No music yet
                        </strong>

                        <p>
                            Add your first song to the Music Library.
                        </p>

                    </div>

                </div>
            }
            else
            {
                <div class="dashboard-list">

                    @foreach (var music in Model.RecentMusic)
                    {
                        <div class="dashboard-list-item dashboard-music-item">

                            <div class="recent-music-icon">

                                <i class="bi bi-file-earmark-music"></i>

                            </div>


                            <div class="dashboard-list-content">

                                <a asp-page="/MusicLibrary/Edit"
                                   asp-route-id="@music.Id"
                                   class="dashboard-item-title">

                                    @music.Title

                                </a>


                                <div class="dashboard-list-meta">

                                    @if (!string.IsNullOrWhiteSpace(music.Composer))
                                    {
                                        <span>

                                            <i class="bi bi-person"></i>

                                            @music.Composer

                                        </span>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(music.SuggestedMassPart))
                                    {
                                        <span class="dashboard-mass-part">

                                            @music.SuggestedMassPart

                                        </span>
                                    }

                                </div>

                            </div>


                            <a asp-page="/MusicLibrary/Edit"
                               asp-route-id="@music.Id"
                               class="btn btn-sm btn-outline-secondary table-action"
                               title="Edit Song"
                               data-bs-toggle="tooltip">

                                <i class="bi bi-pencil"></i>

                            </a>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>


@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.0/dist/chart.umd.min.js"></script>

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const songCount =
                    @Model.SongCount;


                /*
                 * LIBRARY READINESS
                 */

                const readinessCanvas =
                    document.getElementById(
                        "libraryReadinessChart"
                    );


                if (readinessCanvas) {

                    new Chart(
                        readinessCanvas,
                        {
                            type: "bar",

                            data: {

                                labels: [
                                    "Presentation Lyrics",
                                    "PDF Sheet",
                                    "One License",
                                    "Composer"
                                ],

                                datasets: [
                                    {
                                        label: "Ready",

                                        data: [
                                            @Model.SongsWithLyricsCount,
                                            @Model.SongsWithPdfCount,
                                            @Model.SongsWithOneLicenseCount,
                                            @Model.SongsWithComposerCount
                                        ],

                                        backgroundColor: [
                                            "rgba(37, 99, 235, 0.82)",
                                            "rgba(15, 138, 112, 0.82)",
                                            "rgba(217, 162, 56, 0.86)",
                                            "rgba(124, 92, 196, 0.82)"
                                        ],

                                        borderColor: [
                                            "rgb(37, 99, 235)",
                                            "rgb(15, 138, 112)",
                                            "rgb(217, 162, 56)",
                                            "rgb(124, 92, 196)"
                                        ],

                                        borderWidth: 1,
                                        borderRadius: 8,
                                        borderSkipped: false,
                                        barThickness: 26
                                    }
                                ]
                            },

                            options: {

                                indexAxis: "y",

                                responsive: true,

                                maintainAspectRatio: false,


                                animation: {
                                    duration: 700
                                },


                                onHover: function (
                                    event,
                                    elements
                                ) {

                                    if (
                                        event.native &&
                                        event.native.target
                                    ) {

                                        event.native.target
                                            .style.cursor =
                                            elements.length > 0
                                                ? "pointer"
                                                : "default";
                                    }
                                },


                                onClick: function (
                                    event,
                                    elements
                                ) {

                                    if (
                                        elements.length === 0
                                    ) {
                                        return;
                                    }

                                    const index =
                                        elements[0].index;

                                    const filters = [
                                        "missing-lyrics",
                                        "missing-pdf",
                                        "missing-one-license",
                                        "missing-composer"
                                    ];

                                    window.location.href =
                                        `/MusicLibrary?filter=${encodeURIComponent(filters[index])}`;
                                },


                                interaction: {
                                    intersect: false,
                                    mode: "nearest"
                                },


                                plugins: {

                                    legend: {
                                        display: false
                                    },


                                    tooltip: {

                                        displayColors: false,

                                        backgroundColor:
                                            "rgba(15, 47, 102, 0.96)",

                                        titleColor:
                                            "#ffffff",

                                        bodyColor:
                                            "#e8eef8",

                                        padding: 12,

                                        cornerRadius: 8,


                                        callbacks: {

                                            label: function (
                                                context
                                            ) {

                                                const value =
                                                    Number(
                                                        context.raw ??
                                                        0
                                                    );

                                                const missing =
                                                    Math.max(
                                                        songCount -
                                                        value,
                                                        0
                                                    );

                                                const percentage =
                                                    songCount === 0
                                                        ? 0
                                                        : Math.round(
                                                            value /
                                                            songCount *
                                                            100
                                                        );

                                                return [
                                                    `${value} of ${songCount} ready`,
                                                    `${percentage}% complete`,
                                                    `${missing} missing — click to review`
                                                ];
                                            }
                                        }
                                    }
                                },


                                scales: {

                                    x: {

                                        beginAtZero: true,

                                        suggestedMax:
                                            Math.max(
                                                songCount,
                                                1
                                            ),

                                        ticks: {

                                            precision: 0,

                                            color: "#8190a5",

                                            font: {
                                                size: 11
                                            }
                                        },

                                        grid: {

                                            color:
                                                "rgba(100, 116, 139, 0.10)",

                                            drawTicks: false
                                        },

                                        border: {
                                            display: false
                                        }
                                    },


                                    y: {

                                        ticks: {

                                            color: "#42546d",

                                            font: {
                                                size: 11,
                                                weight: "600"
                                            }
                                        },

                                        grid: {
                                            display: false
                                        },

                                        border: {
                                            display: false
                                        }
                                    }
                                }
                            }
                        }
                    );
                }


                /*
                 * SONGS BY MASS PART
                 */

                const massPartCanvas =
                    document.getElementById(
                        "massPartChart"
                    );


                if (massPartCanvas) {

                    const massPartLabels = [

                        @foreach (var item in Model.LibraryBreakdown)
                        {
                            @: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Name)),
                        }

                    ];


                    const massPartValues = [

                        @foreach (var item in Model.LibraryBreakdown)
                        {
                            @: @item.Count,
                        }

                    ];


                    new Chart(
                        massPartCanvas,
                        {
                            type: "bar",

                            data: {

                                labels:
                                    massPartLabels,

                                datasets: [
                                    {
                                        label: "Songs",

                                        data:
                                            massPartValues,

                                        backgroundColor:
                                            "rgba(124, 92, 196, 0.78)",

                                        borderColor:
                                            "rgb(124, 92, 196)",

                                        borderWidth: 1,

                                        borderRadius: 8,

                                        borderSkipped: false,

                                        barThickness: 18
                                    }
                                ]
                            },


                            options: {

                                indexAxis: "y",

                                responsive: true,

                                maintainAspectRatio: false,


                                animation: {
                                    duration: 700
                                },


                                onHover: function (
                                    event,
                                    elements
                                ) {

                                    if (
                                        event.native &&
                                        event.native.target
                                    ) {

                                        event.native.target
                                            .style.cursor =
                                            elements.length > 0
                                                ? "pointer"
                                                : "default";
                                    }
                                },


                                onClick: function (
                                    event,
                                    elements
                                ) {

                                    if (
                                        elements.length === 0
                                    ) {
                                        return;
                                    }

                                    const index =
                                        elements[0].index;

                                    const massPart =
                                        massPartLabels[index];

                                    window.location.href =
                                        `/MusicLibrary?part=${encodeURIComponent(massPart)}`;
                                },


                                interaction: {
                                    intersect: false,
                                    mode: "nearest"
                                },


                                plugins: {

                                    legend: {
                                        display: false
                                    },


                                    tooltip: {

                                        displayColors: false,

                                        backgroundColor:
                                            "rgba(53, 35, 92, 0.96)",

                                        titleColor:
                                            "#ffffff",

                                        bodyColor:
                                            "#efeafd",

                                        padding: 12,

                                        cornerRadius: 8,


                                        callbacks: {

                                            label: function (
                                                context
                                            ) {

                                                const value =
                                                    Number(
                                                        context.raw ??
                                                        0
                                                    );

                                                return [
                                                    `${value} song${value === 1 ? "" : "s"}`,
                                                    "Click to view in Music Library"
                                                ];
                                            }
                                        }
                                    }
                                },


                                scales: {

                                    x: {

                                        beginAtZero: true,

                                        ticks: {

                                            precision: 0,

                                            color: "#8190a5",

                                            font: {
                                                size: 11
                                            }
                                        },

                                        grid: {

                                            color:
                                                "rgba(100, 116, 139, 0.10)",

                                            drawTicks: false
                                        },

                                        border: {
                                            display: false
                                        }
                                    },


                                    y: {

                                        ticks: {

                                            color: "#42546d",

                                            font: {
                                                size: 11,
                                                weight: "600"
                                            }
                                        },

                                        grid: {
                                            display: false
                                        },

                                        border: {
                                            display: false
                                        }
                                    }
                                }
                            }
                        }
                    );
                }

            }
        );

    </script>
}