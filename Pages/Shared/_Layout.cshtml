<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Choir Music System</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="app-header">

        <nav class="navbar navbar-expand-md">

            <div class="container">

                <!-- BRAND -->

                <a class="navbar-brand app-brand"
                   asp-page="/Index">

                    <span class="brand-mark"
                          aria-hidden="true">

                        <svg viewBox="0 0 64 64"
                             role="img">

                            <!-- outer arch -->
                            <path class="brand-mark-arch"
                                  d="M11 32C11 18.7 20.4 8 32 8s21 10.7 21 24" />

                            <!-- music stave -->
                            <path class="brand-mark-staff"
                                  d="M8 41h48M10 46h44M14 51h36" />

                            <!-- note -->
                            <path class="brand-mark-note"
                                  d="M35 15v25.5c-2.2-1.2-5.4-1.1-7.8.3-3.2 1.9-4.5 5.2-2.8 7.4 1.7 2.2 5.7 2.5 8.9.6 2.6-1.5 3.7-3.8 3.7-6.4V24l12-3.2v14.5c-2.2-1.2-5.3-1-7.6.4-3.2 1.9-4.5 5.1-2.8 7.3 1.7 2.2 5.7 2.5 8.8.7 2.6-1.5 3.7-3.9 3.7-6.5V14.8L35 18.1z" />

                            <!-- book -->
                            <path class="brand-mark-book"
                                  d="M9 52c7.5-1.7 15-.8 23 3.5C40 51.2 47.5 50.3 55 52v5c-7.2-1.4-14.5-.4-23 4-8.5-4.4-15.8-5.4-23-4z" />

                        </svg>

                    </span>


                    <span class="brand-copy">

                        <span class="brand-name">
                            Choir
                        </span>

                        <span class="brand-subtitle">
                            Music System
                        </span>

                    </span>

                </a>


                <!-- MOBILE NAV BUTTON -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION -->

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto align-items-md-center">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/Index">

                                <i class="bi bi-house"></i>

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/MusicLibrary/Index">

                                <i class="bi bi-music-note-list"></i>

                                Music Library

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/Masses/Index">

                                <i class="bi bi-calendar-event"></i>

                                Masses

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/PresentationLibrary/Index">

                                <i class="bi bi-easel2"></i>

                                Presentation Library

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/MassTemplates/Index">

                                <i class="bi bi-layers"></i>

                                Mass Templates

                            </a>

                        </li>


                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                asp-page="/Admin/Backup">

                                    <i class="bi bi-database-gear"></i>

                                    Backup & Restore

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                asp-page="/Admin/Users/Index">

                                    <i class="bi bi-people"></i>

                                    Users

                                </a>

                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item ms-md-2">
                                    <form method="post"
                                        asp-page="/Account/Logout"
                                        class="d-inline">

                                        <button type="submit"
                                                class="nav-link btn btn-link border-0">

                                            <i class="bi bi-box-arrow-right"></i>

                                            Logout

                                        </button>

                                    </form>
                                </li>
                            }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <div class="container">

        <main role="main"
              class="py-4">

            @RenderBody()

        </main>

    </div>


    <footer class="app-footer">

        <div class="container">

            <div class="d-flex align-items-center justify-content-between">

                <span>
                    &copy; 2026 Choir Music System
                </span>

                <span class="footer-tagline">
                    Plan · Prepare · Praise
                </span>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                document
                    .querySelectorAll(
                        '[data-bs-toggle="tooltip"]'
                    )
                    .forEach(
                        element =>
                            new bootstrap.Tooltip(
                                element
                            )
                    );

            }
        );

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>