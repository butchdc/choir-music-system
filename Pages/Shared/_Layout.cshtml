<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Choir Music System</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom">
            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-page="/Index">

                    <span class="navbar-brand-icon">
                        <i class="bi bi-music-note-beamed"></i>
                    </span>

                    <span>Choir Music System</span>
                </a>

                <!-- Mobile -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation -->
                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto align-items-md-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Index">
                                <i class="bi bi-house me-1"></i>
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/MusicLibrary/Index">
                                <i class="bi bi-music-note-list me-1"></i>
                                Music Library
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Masses/Index">
                                <i class="bi bi-calendar-event me-1"></i>
                                Masses
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                            asp-page="/PresentationLibrary/Index">
                                <i class="bi bi-easel2 me-1"></i>
                                Presentation Library
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                            asp-page="/Admin/Backup">
                                <i class="bi bi-database-gear me-1"></i>
                                Backup & Restore
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>


    <footer class="app-footer">
        <div class="container">
            <span>
                &copy; 2026 Choir Music System
            </span>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('[data-bs-toggle="tooltip"]')
                .forEach(element => new bootstrap.Tooltip(element));
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>