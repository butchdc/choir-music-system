<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Choir Music System</title>

    <link rel="icon"
      type="image/png"
      href="~/images/choir-icon.png" />

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="app-header">

        <nav class="navbar navbar-expand-md">

            <div class="container">

                <!-- BRAND -->

                <a class="navbar-brand app-brand"
                    asp-page="/Index">

                        <img src="~/images/choir-icon.png"
                            alt=""
                            class="navbar-logo"
                            aria-hidden="true" />

                        <span class="brand-copy">

                            <span class="brand-name">
                                Choir
                            </span>

                            <span class="brand-subtitle">
                                Music System
                            </span>

                        </span>

                    </a>


                <!-- MOBILE NAV BUTTON -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION -->

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto align-items-md-center">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/Index">

                                <i class="bi bi-house"></i>

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/MusicLibrary/Index">

                                <i class="bi bi-music-note-list"></i>

                                Music Library

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/Masses/Index">

                                <i class="bi bi-calendar-event"></i>

                                Masses

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/PresentationLibrary/Index">

                                <i class="bi bi-easel2"></i>

                                Presentation Library

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/MassTemplates/Index">

                                <i class="bi bi-layers"></i>

                                Mass Templates

                            </a>

                        </li>


                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                asp-page="/Admin/Backup">

                                    <i class="bi bi-database-gear"></i>

                                    Backup & Restore

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                asp-page="/Admin/Users/Index">

                                    <i class="bi bi-people"></i>

                                    Users

                                </a>

                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item ms-md-2">
                                    <form method="post"
                                        asp-page="/Account/Logout"
                                        class="d-inline">

                                        <button type="submit"
                                                class="nav-link btn btn-link border-0">

                                            <i class="bi bi-box-arrow-right"></i>

                                            Logout

                                        </button>

                                    </form>
                                </li>
                            }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <div class="container">

        <main role="main"
              class="py-4">

            @RenderBody()

        </main>

    </div>


    <footer class="app-footer">

        <div class="container">

            <div class="d-flex align-items-center justify-content-between">

                <span>
                    &copy; 2026 Choir Music System
                </span>

                <span class="footer-tagline">
                    Plan · Prepare · Praise
                </span>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                document
                    .querySelectorAll(
                        '[data-bs-toggle="tooltip"]'
                    )
                    .forEach(
                        element =>
                            new bootstrap.Tooltip(
                                element
                            )
                    );

            }
        );

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>