@page
@model choir_music_system.Pages.MassTemplates.CreateModel

@{
    ViewData["Title"] = "Create Mass Template";
}

<h1>Create Mass Template</h1>

<form method="post">

    <div class="mb-3">
        <label asp-for="Template.Name"
               class="form-label">
            Name
        </label>

        <input asp-for="Template.Name"
               class="form-control" />

        <span asp-validation-for="Template.Name"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Template.Notes"
               class="form-label">
            Notes
        </label>

        <textarea asp-for="Template.Notes"
                  class="form-control"
                  rows="4"></textarea>
    </div>

    <button type="submit"
            class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i>
        Create Template
    </button>

    <a asp-page="./Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}