@page
@model choir_music_system.Pages.PresentationLibrary.EditModel

@{
    ViewData["Title"] = "Edit Presentation Item";
}

<h1>Edit Presentation Item</h1>

<form method="post">

    <input type="hidden" asp-for="Item.Id" />
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="mb-3">
        <label asp-for="Item.Title" class="form-label">
            Title
        </label>

        <input asp-for="Item.Title" class="form-control" />

        <span asp-validation-for="Item.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Item.Type" class="form-label">
            Type
        </label>

        <select asp-for="Item.Type" class="form-select">
            <option value="Psalm Response">Psalm Response</option>
            <option value="Creed">Creed</option>
            <option value="Prayer">Prayer</option>
            <option value="Response">Response</option>
            <option value="Notice">Notice</option>
            <option value="Custom">Custom</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Item.Language" class="form-label">
            Language
        </label>

        <select asp-for="Item.Language" class="form-select">
            <option value="English">English</option>
            <option value="Tagalog">Tagalog</option>
            <option value="Other">Other</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Item.PresentationText" class="form-label">
            Presentation Text
        </label>

        <textarea asp-for="Item.PresentationText" class="form-control font-monospace" rows="12" placeholder="[SLIDE:TITLED]
        First slide...

        [SLIDE]
        Next slide..."></textarea>

        <div class="form-text">
            Use <code>[SLIDE:TITLED]</code> and <code>[SLIDE]</code>
            the same way as song presentation lyrics.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i>
        Save Changes
    </button>

    @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
    {
        <a href="@Model.ReturnUrl" class="btn btn-secondary">
            Cancel
        </a>
    }
    else
    {
        <a asp-page="./Index" class="btn btn-secondary">
            Cancel
        </a>
    }

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}