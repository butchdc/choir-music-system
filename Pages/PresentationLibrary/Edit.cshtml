@page
@model choir_music_system.Pages.PresentationLibrary.EditModel

@{
    ViewData["Title"] = "Edit Presentation Item";
}

<h1>Edit Presentation Item</h1>

<form method="post">

    <input type="hidden" asp-for="Item.Id" />

    <div class="mb-3">
        <label asp-for="Item.Title" class="form-label">Title</label>
        <input asp-for="Item.Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Item.Type" class="form-label">Type</label>

        <select asp-for="Item.Type" class="form-select">
            <option value="Psalm Response">Psalm Response</option>
            <option value="Creed">Creed</option>
            <option value="Prayer">Prayer</option>
            <option value="Response">Response</option>
            <option value="Notice">Notice</option>
            <option value="Custom">Custom</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Item.LayoutType" class="form-label">Layout</label>

        <select asp-for="Item.LayoutType" class="form-select">
            <option value="Title + Text">Title + Text</option>
            <option value="Text Only">Text Only</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Item.PresentationText" class="form-label">
            Presentation Text
        </label>

        <textarea asp-for="Item.PresentationText"
                  class="form-control font-monospace"
                  rows="12"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-page="./Index" class="btn btn-outline-secondary">
        Cancel
    </a>

</form>