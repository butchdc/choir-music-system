@page
@model choir_music_system.Pages.PresentationLibrary.CreateModel

@{
    ViewData["Title"] = "Add Presentation Item";
}

<div class="presentation-editor-page">

    <div class="presentation-editor-header">

        <a asp-page="./Index" class="presentation-editor-back">

            <i class="bi bi-arrow-left"></i>
            Presentation Library

        </a>


        <div class="presentation-editor-heading">

            <div class="presentation-editor-heading-icon">
                <i class="bi bi-file-earmark-slides"></i>
            </div>

            <div>

                <div class="presentation-editor-kicker">
                    Presentation Library
                </div>

                <h1>Add Presentation Item</h1>

                <p>
                    Create reusable prayers, responses, creeds
                    and other content for Mass presentations.
                </p>

            </div>

        </div>

    </div>


    <form method="post" class="presentation-editor-form">

        <div asp-validation-summary="ModelOnly" class="alert alert-danger">
        </div>


        <div class="presentation-editor-grid">

            <!-- MAIN EDITOR -->

            <div class="presentation-editor-main">

                <section class="presentation-editor-card">

                    <div class="presentation-editor-card-header">

                        <div class="presentation-editor-card-icon">
                            <i class="bi bi-card-heading"></i>
                        </div>

                        <div>
                            <h2>Item Details</h2>

                            <p>
                                Give this reusable presentation
                                item a clear name and classification.
                            </p>
                        </div>

                    </div>


                    <div class="presentation-editor-details-grid">

                        <div class="presentation-editor-field presentation-editor-title-field">

                            <label asp-for="Item.Title" class="form-label">
                                Title
                            </label>

                            <input asp-for="Item.Title" class="form-control" placeholder="e.g. Nicene Creed" />

                            <span asp-validation-for="Item.Title" class="text-danger">
                            </span>

                        </div>


                        <div class="presentation-editor-field">

                            <label asp-for="Item.Type" class="form-label">
                                Type
                            </label>

                            <select asp-for="Item.Type" class="form-select">

                                <option value="Psalm Response">
                                    Psalm Response
                                </option>

                                <option value="Creed">
                                    Creed
                                </option>

                                <option value="Prayer">
                                    Prayer
                                </option>

                                <option value="Response">
                                    Response
                                </option>

                                <option value="Notice">
                                    Notice
                                </option>

                                <option value="Custom">
                                    Custom
                                </option>

                            </select>

                        </div>


                        <div class="presentation-editor-field">

                            <label asp-for="Item.Language" class="form-label">
                                Language
                            </label>

                            <select asp-for="Item.Language" class="form-select">

                                <option value="English">
                                    English
                                </option>

                                <option value="Tagalog">
                                    Tagalog
                                </option>

                                <option value="Bilingual">
                                    Bilingual
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                        </div>

                    </div>

                </section>


                <section class="presentation-editor-card presentation-text-card">

                    <div class="presentation-editor-card-header">

                        <div class="presentation-editor-card-icon purple">
                            <i class="bi bi-easel2"></i>
                        </div>

                        <div>
                            <h2>Presentation Text</h2>

                            <p>
                                Define how the content should be split
                                across PowerPoint slides.
                            </p>
                        </div>

                    </div>


                    <div class="presentation-editor-field">

                        <textarea asp-for="Item.PresentationText" id="presentationTextEditor"
                                  class="form-control presentation-text-editor" rows="16" placeholder="[SLIDE:TITLED]
                        First slide...

                        [SLIDE]
                        Next slide..."></textarea>

                    </div>


                    <div class="presentation-editor-hints">

                        <div class="presentation-editor-hint">

                            <code>[SLIDE:TITLED]</code>

                            <span>
                                Starts a slide using the item's
                                title as the slide heading.
                            </span>

                        </div>


                        <div class="presentation-editor-hint">

                            <code>[SLIDE]</code>

                            <span>
                                Starts a standard continuation slide.
                            </span>

                        </div>

                    </div>

                </section>

            </div>


            <!-- SIDE HELP -->

            <aside class="presentation-editor-sidebar">

                <div class="presentation-preview-help">

                    <div class="presentation-preview-help-icon">
                        <i class="bi bi-lightbulb"></i>
                    </div>

                    <div>
                        <strong>Writing tip</strong>

                        <p>
                            Keep each slide concise so the text
                            remains readable when projected.
                        </p>
                    </div>

                </div>


                <div class="presentation-slide-guide">

                    <div class="presentation-slide-guide-heading">

                        <i class="bi bi-layout-text-window"></i>

                        <span>Example Structure</span>

                    </div>

                    <div class="presentation-slide-example">

                        <span class="presentation-slide-tag">
                            [SLIDE:TITLED]
                        </span>

                        <strong>
                            Opening
                        </strong>

                        <p>
                            First section of presentation text.
                        </p>

                    </div>


                    <div class="presentation-slide-example">

                        <span class="presentation-slide-tag">
                            [SLIDE]
                        </span>

                        <strong>
                            Continuation
                        </strong>

                        <p>
                            Additional content on the next slide.
                        </p>

                    </div>

                </div>

            </aside>

        </div>


        <div class="presentation-editor-actions">

            <div class="presentation-editor-actions-info">

                <i class="bi bi-info-circle"></i>

                <span>
                    This item will become available in Mass Plan.
                </span>

            </div>


            <div class="presentation-editor-actions-buttons">

                <a asp-page="./Index" class="btn btn-outline-secondary">

                    Cancel

                </a>

                <button type="submit" class="btn btn-warning presentation-editor-save">

                    <i class="bi bi-check2-circle me-1"></i>

                    Save Presentation Item

                </button>

            </div>

        </div>

    </form>

</div>