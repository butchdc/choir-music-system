@page
@model choir_music_system.Pages.PresentationLibrary.DeleteModel

@{
    ViewData["Title"] = "Delete Presentation Item";
}

<h1>Delete Presentation Item</h1>

<p>
    Are you sure you want to remove
    <strong>@Model.Item.Title</strong>
    from the Presentation Library?
</p>

<form method="post">

    <input type="hidden" asp-for="Item.Id" />
    <input type="hidden" asp-for="ReturnUrl" />

    <button type="submit"
            class="btn btn-danger">
        <i class="bi bi-trash me-1"></i>
        Delete
    </button>

    @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
    {
        <a href="@Model.ReturnUrl"
           class="btn btn-outline-secondary">
            Cancel
        </a>
    }
    else
    {
        <a asp-page="./Index"
           class="btn btn-outline-secondary">
            Cancel
        </a>
    }

</form>