@page
@model choir_music_system.Pages.PresentationLibrary.IndexModel

@{
    ViewData["Title"] = "Presentation Library";

    var titleDirection =
        Model.Sort == "title" &&
        Model.Direction == "asc"
            ? "desc"
            : "asc";

    var typeDirection =
        Model.Sort == "type" &&
        Model.Direction == "asc"
            ? "desc"
            : "asc";

    var languageDirection =
        Model.Sort == "language" &&
        Model.Direction == "asc"
        ? "desc"
        : "asc";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Presentation Library</h1>
        <p class="text-muted mb-0">
            Reusable responses, prayers, creeds and other presentation content.
        </p>
    </div>

    <a asp-page="./Create" class="btn btn-primary">
        Add Presentation Item
    </a>
</div>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-light border">
        No presentation items have been added yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>
                        <a asp-page="./Index" asp-route-sort="title" asp-route-direction="@titleDirection"
                           class="text-white text-decoration-none">
                            Title
                        </a>
                    </th>

                    <th>
                        <a asp-page="./Index" asp-route-sort="type" asp-route-direction="@typeDirection"
                           class="text-white text-decoration-none">
                            Type
                        </a>
                    </th>
                    <th>
                        <a asp-page="./Index" asp-route-sort="language" asp-route-direction="@languageDirection"
                           class="text-white text-decoration-none">
                            Language
                        </a>
                    </th>
                    <th class="text-end text-white">
                        Actions
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">
                            @item.Title
                        </td>

                        <td>
                            @item.Type
                        </td>

                        <td>
                            @item.Language
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">

                                <a asp-page="Edit" asp-route-id="@item.Id"
                                   asp-route-returnUrl="@($"{Request.Path}{Request.QueryString}")"
                                   class="btn btn-sm btn-outline-secondary table-action" title="Edit" data-bs-toggle="tooltip">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-page="Delete" asp-route-id="@item.Id"
                                   asp-route-returnUrl="@($"{Request.Path}{Request.QueryString}")"
                                   class="btn btn-sm btn-outline-danger table-action" title="Delete" data-bs-toggle="tooltip">
                                    <i class="bi bi-trash"></i>
                                </a>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}