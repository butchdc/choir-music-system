@page
@model choir_music_system.Pages.MusicLibrary.CreateModel

@{
    ViewData["Title"] = "Upload Music Sheet";
}

<div class="music-editor-page">

    <div class="music-editor-header">

        <a asp-page="Index"
           class="music-editor-back">

            <i class="bi bi-arrow-left"></i>
            Music Library

        </a>


        <div class="music-editor-heading">

            <div class="music-editor-heading-icon">
                <i class="bi bi-music-note-beamed"></i>
            </div>

            <div>

                <div class="music-editor-kicker">
                    Music Library
                </div>

                <h1>Upload Music Sheet</h1>

                <p>
                    Add a PDF music sheet with song,
                    licensing and presentation details.
                </p>

            </div>

        </div>

    </div>


    <form method="post"
          enctype="multipart/form-data"
          asp-page="/MusicLibrary/Create"
          class="music-editor-form">

        <input type="hidden"
               asp-for="PendingPdfFileName" />

        <input type="hidden"
               asp-for="OriginalPdfFileName" />


        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <div class="music-editor-grid">

            <div class="music-editor-main">


                <!-- PDF -->

                <section class="music-editor-card">

                    <div class="music-editor-card-header">

                        <div class="music-editor-card-icon pdf">
                            <i class="bi bi-file-earmark-pdf"></i>
                        </div>

                        <div>

                            <h2>Music Sheet PDF</h2>

                            <p>
                                Upload the source PDF for this song.
                            </p>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(
                        Model.OriginalPdfFileName))
                    {
                        <div class="music-pdf-ready">

                            <i class="bi bi-check-circle-fill"></i>

                            <div>

                                <strong>PDF ready</strong>

                                <span>
                                    @Model.OriginalPdfFileName
                                </span>

                            </div>

                        </div>
                    }


                    <div class="music-editor-field">

                        <label asp-for="PdfFile"
                               class="form-label">

                            Music Sheet PDF

                        </label>

                        <input asp-for="PdfFile"
                               type="file"
                               accept=".pdf,application/pdf"
                               class="form-control"
                               id="pdfFileInput" />

                        @if (string.IsNullOrWhiteSpace(
                            Model.PendingPdfFileName))
                        {
                            <span asp-validation-for="PdfFile"
                                  class="text-danger">
                            </span>
                        }

                        <div class="form-text">
                            Selecting a PDF will automatically
                            check the file before continuing.
                        </div>

                    </div>

                </section>



                <!-- SONG DETAILS -->

                <section class="music-editor-card">

                    <div class="music-editor-card-header">

                        <div class="music-editor-card-icon">
                            <i class="bi bi-card-heading"></i>
                        </div>

                        <div>

                            <h2>Song Details</h2>

                            <p>
                                Core information used throughout
                                Mass planning and search.
                            </p>

                        </div>

                    </div>


                    <div class="music-editor-details-grid">

                        <div class="music-editor-field music-editor-title">

                            <label asp-for="Song.Title"
                                   class="form-label">
                                Title
                            </label>

                            <input asp-for="Song.Title"
                                   class="form-control"
                                   placeholder="Song title" />

                            <span asp-validation-for="Song.Title"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="music-editor-field">

                            <label asp-for="Song.SuggestedMassPart"
                                   class="form-label">
                                Suggested Mass Part
                            </label>

                            <select asp-for="Song.SuggestedMassPart"
                                    class="form-select">

                                <option value="">
                                    None / Not specified
                                </option>

                                <option>Entrance</option>
                                <option>Kyrie</option>
                                <option>Gloria</option>
                                <option>Psalm</option>
                                <option>Alleluia</option>
                                <option>Offertory</option>
                                <option>Holy</option>
                                <option>Memorial Acclamation</option>
                                <option>Amen</option>
                                <option>Our Father</option>
                                <option>Lamb of God</option>
                                <option>Communion</option>
                                <option>Recessional</option>
                                <option>Mass Setting</option>

                            </select>

                        </div>


                        <div class="music-editor-field">

                            <label asp-for="Song.Composer"
                                   class="form-label">
                                Composer
                            </label>

                            <input asp-for="Song.Composer"
                                   class="form-control"
                                   placeholder="Composer" />

                        </div>


                        <div class="music-editor-field">

                            <label asp-for="Song.Arrangement"
                                   class="form-label">
                                Arrangement
                            </label>

                            <input asp-for="Song.Arrangement"
                                   class="form-control"
                                   placeholder="Optional arrangement" />

                        </div>


                        <div class="music-editor-field">

                            <label asp-for="Song.Key"
                                   class="form-label">
                                Key
                            </label>

                            <input asp-for="Song.Key"
                                   class="form-control"
                                   placeholder="e.g. G" />

                        </div>

                    </div>


                    <div class="music-editor-field mt-3">

                        <label asp-for="Song.Notes"
                               class="form-label">
                            Notes
                        </label>

                        <textarea asp-for="Song.Notes"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Optional notes about this arrangement or usage..."></textarea>

                    </div>

                </section>



                <!-- LICENSING -->

                <section class="music-editor-card">

                    <div class="music-editor-card-header">

                        <div class="music-editor-card-icon licence">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>

                            <h2>Licensing</h2>

                            <p>
                                Copyright and OneLicense information
                                used in generated presentations.
                            </p>

                        </div>

                    </div>


                    <div class="music-editor-license-grid">

                        <div class="music-editor-field">

                            <label asp-for="Song.OneLicenseNumber"
                                   class="form-label">
                                OneLicense Number
                            </label>

                            <input asp-for="Song.OneLicenseNumber"
                                   class="form-control"
                                   placeholder="e.g. 87214" />

                        </div>


                        <div class="music-editor-field">

                            <label asp-for="Song.Publisher"
                                   class="form-label">
                                Publisher
                            </label>

                            <input asp-for="Song.Publisher"
                                   class="form-control"
                                   placeholder="e.g. OCP" />

                        </div>

                    </div>


                    <div class="music-editor-field mt-3">

                        <label asp-for="Song.CopyrightText"
                               class="form-label">
                            Copyright / Licence Text
                        </label>

                        <textarea asp-for="Song.CopyrightText"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional copyright or licence wording"></textarea>

                    </div>

                </section>



                <!-- PRESENTATION -->

                <section class="music-editor-card">

                    <div class="music-editor-card-header">

                        <div class="music-editor-card-icon presentation">
                            <i class="bi bi-easel2"></i>
                        </div>

                        <div>

                            <h2>Presentation Lyrics</h2>

                            <p>
                                Define the lyrics used when generating
                                the Mass PowerPoint presentation.
                            </p>

                        </div>

                    </div>


                    <div class="music-editor-field">

                        <textarea asp-for="Song.PresentationLyrics"
                                  class="form-control music-presentation-editor"
                                  rows="16"
                                  placeholder="[SLIDE:TITLED]
First slide lyrics here...

[SLIDE]
Next slide lyrics here..."></textarea>

                    </div>


                    <div class="music-presentation-hints">

                        <div>

                            <code class="copy-slide-marker"
                                role="button"
                                title="Click to copy"
                                onclick="copySlideMarker('[SLIDE:TITLED]', this)">[SLIDE:TITLED]</code>

                            <span>
                                Title, composer and licence slide
                            </span>

                        </div>

                        <div>

                            <code class="copy-slide-marker"
                                role="button"
                                title="Click to copy"
                                onclick="copySlideMarker('[SLIDE]', this)">[SLIDE]</code>

                            <span>
                                Lyrics-only continuation slide
                            </span>

                        </div>

                    </div>

                </section>

            </div>



            <!-- SIDEBAR -->

            <aside class="music-editor-sidebar">

                <div class="music-editor-help">

                    <div class="music-editor-help-icon">
                        <i class="bi bi-lightbulb"></i>
                    </div>

                    <div>

                        <strong>Library readiness</strong>

                        <p>
                            A complete song has its PDF, composer,
                            licensing information and presentation lyrics.
                        </p>

                    </div>

                </div>


                <div class="music-editor-info-card">

                    <div class="music-editor-info-heading">

                        <i class="bi bi-list-check"></i>
                        Used for

                    </div>

                    <div class="music-editor-info-row">

                        <i class="bi bi-calendar-event"></i>

                        <span>
                            Mass planning
                        </span>

                    </div>

                    <div class="music-editor-info-row">

                        <i class="bi bi-file-earmark-pdf"></i>

                        <span>
                            Music packs
                        </span>

                    </div>

                    <div class="music-editor-info-row">

                        <i class="bi bi-file-earmark-slides"></i>

                        <span>
                            PowerPoint presentations
                        </span>

                    </div>

                    <div class="music-editor-info-row">

                        <i class="bi bi-shield-check"></i>

                        <span>
                            Licence reporting
                        </span>

                    </div>

                </div>

            </aside>

        </div>



        <!-- ACTIONS -->

        <div class="music-editor-actions">

            <div class="music-editor-actions-info">

                <i class="bi bi-info-circle"></i>

                <span>
                    You can update these details later.
                </span>

            </div>


            <div class="music-editor-actions-buttons">

                <a asp-page="Index"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>


                <button type="submit"
                        asp-page="/MusicLibrary/Create"
                        class="btn btn-warning music-editor-save">

                    <i class="bi bi-check2-circle me-1"></i>

                    Save Music Sheet

                </button>

            </div>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        const pdfInput =
            document.getElementById("pdfFileInput");

        pdfInput?.addEventListener(
            "change",
            function () {

                if (
                    !this.files ||
                    this.files.length === 0
                ) {
                    return;
                }

                const form = this.form;

                form.action = "?handler=Detect";
                form.noValidate = true;
                form.submit();

            }
        );

        async function copySlideMarker(text, element) {
            await navigator.clipboard.writeText(text);

            const originalText = element.textContent;

            element.textContent = "Copied!";

            setTimeout(() => {
                element.textContent = originalText;
            }, 1000);
        }  

    </script>
}