@page
@model choir_music_system.Pages.MusicLibrary.BulkUploadModel

@{
    ViewData["Title"] = "Bulk Upload Music Sheets";
}

<h1>Bulk Upload Music Sheets</h1>

<p class="text-muted">
    Upload multiple PDF music sheets to the choir library.
    Titles will be detected automatically.
</p>

<form method="post" enctype="multipart/form-data">

    <div class="mb-3">
        <label asp-for="PdfFiles" class="form-label">
            Music Sheet PDFs
        </label>

        <input asp-for="PdfFiles"
               type="file"
               accept=".pdf,application/pdf"
               multiple
               class="form-control" />
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Upload Music Sheets
        </button>

        <a asp-page="Index" class="btn btn-secondary">
            Cancel
        </a>
    </div>

</form>

@if (Model.Results.Count > 0)
{
    <hr />

    <h2>Upload Results</h2>

    <ul class="list-group">
        @foreach (var result in Model.Results)
        {
            <li class="list-group-item">
                @result
            </li>
        }
    </ul>

    <div class="mt-3">
        <a asp-page="Index"
           class="btn btn-primary">
            Back to Music Library
        </a>
    </div>
}

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}