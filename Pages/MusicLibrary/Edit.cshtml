@page "{id:int}"
@model choir_music_system.Pages.MusicLibrary.EditModel

@{
    ViewData["Title"] = "Edit Music Sheet";
}

<div class="music-editor-page">

    <div class="music-editor-header">

        <a asp-page="Index" class="music-editor-back">

            <i class="bi bi-arrow-left"></i>
            Music Library

        </a>


        <div class="music-editor-heading">

            <div class="music-editor-heading-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

            <div>

                <div class="music-editor-kicker">
                    Music Library
                </div>

                <h1>Edit Music Sheet</h1>

                <p>
                    Update song details, licensing,
                    PDF and presentation lyrics.
                </p>

            </div>

        </div>

    </div>


    <form method="post" enctype="multipart/form-data" class="music-editor-form">

        <input type="hidden" asp-for="Song.Id" />


        <div asp-validation-summary="ModelOnly" class="alert alert-danger">
        </div>


        <div class="music-editor-grid">

            <div class="music-editor-main">


                <!-- SONG DETAILS -->

                <section class="music-editor-card">

                    <div class="music-editor-card-header">

                        <div class="music-editor-card-icon">
                            <i class="bi bi-card-heading"></i>
                        </div>

                        <div>

                            <h2>Song Details</h2>

                            <p>
                                Core information used throughout
                                the Music Library and Mass planning.
                            </p>

                        </div>

                    </div>


                    <div class="music-editor-details-grid">

                        <div class="music-editor-field music-editor-title">

                            <label asp-for="Song.Title" class="form-label">
                                Title
                            </label>

                            <input asp-for="Song.Title" class="form-control" />

                            <span asp-validation-for="Song.Title" class="text-danger">
                            </span>

                        </div>


                        <div class="music-editor-field">

                            <label asp-for="Song.SuggestedMassPart" class="form-label">
                                Suggested Mass Part
                            </label>

                            <select asp-for="Song.SuggestedMassPart" class="form-select">

                                <option value="">
                                    None / Not specified
                                </option>

                                <option>Entrance</option>
                                <option>Kyrie</option>
                                <option>Gloria</option>
                                <option>Psalm</option>
                                <option>Alleluia</option>
                                <option>Offertory</option>
                                <option>Holy</option>
                                <option>Memorial Acclamation</option>
                                <option>Amen</option>
                                <option>Our Father</option>
                                <option>Lamb of God</option>
                                <option>Communion</option>
                                <option>Recessional</option>
                                <option>Mass Setting</option>

                            </select>

                        </div>


                        <div class="music-editor-field">

                            <label asp-for="Song.Composer" class="form-label">
                                Composer
                            </label>

                            <input asp-for="Song.Composer" class="form-control" />

                        </div>


                        <div class="music-editor-field">

                            <label asp-for="Song.Arrangement" class="form-label">
                                Arrangement
                            </label>

                            <input asp-for="Song.Arrangement" class="form-control" />

                        </div>


                        <div class="music-editor-field">

                            <label asp-for="Song.Key" class="form-label">
                                Key
                            </label>

                            <input asp-for="Song.Key" class="form-control" placeholder="e.g. G" />

                        </div>

                    </div>


                    <div class="music-editor-field mt-3">

                        <label asp-for="Song.Notes" class="form-label">
                            Notes
                        </label>

                        <textarea asp-for="Song.Notes" class="form-control" rows="4"
                                  placeholder="Optional notes about this arrangement or usage..."></textarea>

                    </div>

                </section>



                <!-- PDF -->

                <section class="music-editor-card">

                    <div class="music-editor-card-header">

                        <div class="music-editor-card-icon pdf">
                            <i class="bi bi-file-earmark-pdf"></i>
                        </div>

                        <div>

                            <h2>Music Sheet PDF</h2>

                            <p>
                                Review the current sheet or replace it
                                with a newer PDF.
                            </p>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(Model.Song.PdfFileName))
                    {
                        <div class="music-current-pdf">

                            <div class="music-current-pdf-icon">
                                <i class="bi bi-file-earmark-pdf"></i>
                            </div>

                            <div class="music-current-pdf-content">

                                <div class="music-current-pdf-label">
                                    Current PDF
                                </div>

                                <strong>
                                    @Model.Song.PdfFileName
                                </strong>

                            </div>


                            <a asp-page="View" asp-route-id="@Model.Song.Id" target="_blank" rel="noopener noreferrer"
                               class="btn btn-sm btn-outline-primary">

                                <i class="bi bi-box-arrow-up-right me-1"></i>
                                View

                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="music-current-pdf missing">

                            <div class="music-current-pdf-icon">
                                <i class="bi bi-exclamation-circle"></i>
                            </div>

                            <div class="music-current-pdf-content">

                                <div class="music-current-pdf-label">
                                    Current PDF
                                </div>

                                <strong>
                                    No PDF uploaded
                                </strong>

                            </div>

                        </div>
                    }


                    <div class="music-editor-field">

                        <label asp-for="PdfFile" class="form-label">

                            @if (!string.IsNullOrWhiteSpace(Model.Song.PdfFileName))
                            {
                                <text>Replace PDF</text>
                            }
                            else
                            {
                                <text>Upload PDF</text>
                            }

                        </label>

                        <input asp-for="PdfFile" type="file" accept=".pdf,application/pdf" class="form-control" />

                        <div class="form-text">

                            @if (!string.IsNullOrWhiteSpace(Model.Song.PdfFileName))
                            {
                                <text>
                                    Leave blank to keep the existing PDF.
                                </text>
                            }
                            else
                            {
                                <text>
                                    Choose the music sheet PDF for this song.
                                </text>
                            }

                        </div>

                        <span asp-validation-for="PdfFile" class="text-danger">
                        </span>

                    </div>

                </section>



                <!-- LICENSING -->

                <section class="music-editor-card">

                    <div class="music-editor-card-header">

                        <div class="music-editor-card-icon licence">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>

                            <h2>Licensing</h2>

                            <p>
                                Copyright and OneLicense information
                                used in generated presentations.
                            </p>

                        </div>

                    </div>


                    <div class="music-editor-license-grid">

                        <div class="music-editor-field">

                            <label asp-for="Song.OneLicenseNumber" class="form-label">
                                OneLicense Number
                            </label>

                            <input asp-for="Song.OneLicenseNumber" class="form-control" placeholder="e.g. 87214" />

                        </div>


                        <div class="music-editor-field">

                            <label asp-for="Song.Publisher" class="form-label">
                                Publisher
                            </label>

                            <input asp-for="Song.Publisher" class="form-control" placeholder="e.g. OCP" />

                        </div>

                    </div>


                    <div class="music-editor-field mt-3">

                        <label asp-for="Song.CopyrightText" class="form-label">
                            Copyright / Licence Text
                        </label>

                        <textarea asp-for="Song.CopyrightText" class="form-control" rows="3"
                                  placeholder="Optional copyright or licence wording"></textarea>

                    </div>

                </section>



                <!-- PRESENTATION -->

                <section class="music-editor-card">

                    <div class="music-editor-card-header">

                        <div class="music-editor-card-icon presentation">
                            <i class="bi bi-easel2"></i>
                        </div>

                        <div>

                            <h2>Presentation Lyrics</h2>

                            <p>
                                Edit the lyrics used in generated
                                PowerPoint presentations.
                            </p>

                        </div>

                    </div>


                    <div class="music-editor-field">

                        <textarea asp-for="Song.PresentationLyrics" class="form-control music-presentation-editor"
                                  rows="16" placeholder="[SLIDE:TITLED]
                        First slide lyrics here...

                        [SLIDE]
                        Next slide lyrics here..."></textarea>

                    </div>


                    <div class="music-presentation-hints">

                        <div>

                            <code class="copy-slide-marker" role="button" title="Click to copy"
                                  onclick="copySlideMarker('[SLIDE:TITLED]', this)">[SLIDE:TITLED]</code>

                            <span>
                                Title, composer and licence slide
                            </span>

                        </div>

                        <div>

                            <code class="copy-slide-marker" role="button" title="Click to copy"
                                  onclick="copySlideMarker('[SLIDE]', this)">[SLIDE]</code>

                            <span>
                                Lyrics-only continuation slide
                            </span>

                        </div>

                    </div>
                    <hr class="my-4" />

                    <div class="music-editor-field">

                        <div class="d-flex align-items-center justify-content-between mb-2">

                            <div>
                                <label class="form-label mb-1">
                                    Custom Song Presentation
                                </label>

                                <div class="form-text mt-0">
                                    Optional custom PowerPoint used instead of
                                    generated lyrics slides when building a Mass presentation.
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                    Model.Song.CustomPresentationPath))
                            {
                                <span class="badge text-bg-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Custom
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">
                                    Generated
                                </span>
                            }

                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                                Model.Song.CustomPresentationFileName))
                        {
                            <div class="music-current-pdf mb-3">

                                <div class="music-current-pdf-icon">
                                    <i class="bi bi-file-earmark-slides"></i>
                                </div>

                                <div class="music-current-pdf-content">

                                    <div class="music-current-pdf-label">
                                        Current Custom Presentation
                                    </div>

                                    <strong>
                                        @Model.Song.CustomPresentationFileName
                                    </strong>

                                    @if (Model.Song.CustomPresentationUpdatedDate.HasValue)
                                    {
                                        <div class="small text-muted mt-1">
                                            Uploaded
                                            @Model.Song.CustomPresentationUpdatedDate.Value
                                            .ToLocalTime()
                                            .ToString("d MMM yyyy h:mm tt")
                                        </div>
                                    }
                                    <div class="d-flex align-items-center gap-2 mt-3">

                                        <a asp-page="Edit"
                                        asp-page-handler="DownloadCustomPresentation"
                                        asp-route-id="@Model.Song.Id"
                                        class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-download me-1"></i>
                                            Download Custom

                                        </a>

                                        <button type="submit"
                                                asp-page-handler="RemoveCustomPresentation"
                                                class="btn btn-sm btn-outline-danger"
                                                formnovalidate
                                                onclick="return confirm('Remove the custom presentation for this song? The generated presentation from lyrics will still be available.');">

                                            <i class="bi bi-trash me-1"></i>
                                            Remove Custom

                                        </button>

                                    </div>

                                </div>

                            </div>
                        }


                        <label asp-for="CustomPresentationFile" class="form-label">

                            @if (!string.IsNullOrWhiteSpace(
                                    Model.Song.CustomPresentationPath))
                            {
                                <text>Replace Custom Presentation</text>
                            }
                            else
                            {
                                <text>Upload Custom Presentation</text>
                            }

                        </label>

                        <input asp-for="CustomPresentationFile" type="file"
                               accept=".pptx,application/vnd.openxmlformats-officedocument.presentationml.presentation"
                               class="form-control" />

                        <div class="form-text">

                            @if (!string.IsNullOrWhiteSpace(
                                    Model.Song.CustomPresentationPath))
                            {
                                <text>
                                    Leave blank to keep the current custom presentation.
                                    You can still generate a fresh presentation from the
                                    lyrics at any time.
                                </text>
                            }
                            else
                            {
                                <text>
                                    Upload a customised .pptx if this song needs a
                                    presentation different from the automatically
                                    generated version.
                                </text>
                            }

                        </div>

                        <span asp-validation-for="CustomPresentationFile" class="text-danger">
                        </span>

                    </div>

                </section>

            </div>



            <!-- SIDEBAR -->

            <aside class="music-editor-sidebar">

                <div class="music-editor-help">

                    <div class="music-editor-help-icon">
                        <i class="bi bi-lightbulb"></i>
                    </div>

                    <div>

                        <strong>Library readiness</strong>

                        <p>
                            Keep the PDF, composer, licensing
                            and presentation lyrics complete for
                            the best Mass planning experience.
                        </p>

                    </div>

                </div>


                <div class="music-editor-info-card">

                    <div class="music-editor-info-heading">

                        <i class="bi bi-check2-circle"></i>
                        Current Status

                    </div>


                    <div class="music-editor-info-row">

                        @if (!string.IsNullOrWhiteSpace(Model.Song.PdfFileName))
                        {
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>PDF available</span>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-circle text-warning"></i>
                            <span>PDF missing</span>
                        }

                    </div>


                    <div class="music-editor-info-row">

                        @if (!string.IsNullOrWhiteSpace(Model.Song.Composer))
                        {
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Composer available</span>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-circle text-warning"></i>
                            <span>Composer missing</span>
                        }

                    </div>


                    <div class="music-editor-info-row">

                        @if (!string.IsNullOrWhiteSpace(Model.Song.OneLicenseNumber))
                        {
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>OneLicense available</span>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-circle text-warning"></i>
                            <span>OneLicense missing</span>
                        }

                    </div>


                    <div class="music-editor-info-row">

                        @if (!string.IsNullOrWhiteSpace(Model.Song.PresentationLyrics))
                        {
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Presentation lyrics available</span>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-circle text-warning"></i>
                            <span>Presentation lyrics missing</span>
                        }

                    </div>

                </div>

            </aside>

        </div>



        <!-- ACTIONS -->

        <div class="music-editor-actions">

            <div class="music-editor-actions-info">

                <i class="bi bi-check2-circle"></i>

                <span>
                    Changes apply immediately after saving.
                </span>

            </div>


            <div class="music-editor-actions-buttons">

                <a asp-page="Index" class="btn btn-outline-secondary">

                    Cancel

                </a>


                <button type="submit" class="btn btn-warning music-editor-save">

                    <i class="bi bi-check2-circle me-1"></i>
                    Save Changes

                </button>

            </div>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        async function copySlideMarker(text, element) {
            await navigator.clipboard.writeText(text);

            const originalText = element.textContent;

            element.textContent = "Copied!";

            setTimeout(() => {
                element.textContent = originalText;
            }, 1000);
        }  
    </script>
}