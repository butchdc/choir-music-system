@page
@model choir_music_system.Pages.MusicLibrary.IndexModel

@{
    ViewData["Title"] = "Music Library";
}

<!-- MUSIC LIBRARY HEADER -->

<div class="library-header mb-4">

    <div class="library-header-content">

        <div class="library-header-icon">
            <i class="bi bi-music-note-beamed"></i>
        </div>

        <div>

            <div class="library-header-kicker">
                Choir Collection
            </div>

            <h1>
                Music Library
            </h1>

            <p>
                Manage your choir music, presentation lyrics and music sheets.
            </p>

        </div>

    </div>


    <div class="library-header-actions">

        <div class="library-song-count">

            <i class="bi bi-music-note-list"></i>

            <span>
                <strong>@Model.Songs.Count</strong>
                song@(Model.Songs.Count == 1 ? "" : "s")
            </span>

        </div>


        <a asp-page="Create" class="btn library-add-button">

            <i class="bi bi-plus-lg"></i>

            Add Song

        </a>

    </div>

</div>

@if (Model.Songs.Count == 0)
{
    <div class="alert alert-info">
        No music sheets have been uploaded yet.
    </div>
}
else
{
    <!-- MUSIC LIBRARY TOOLBAR -->

    <div class="library-toolbar">

        <div class="library-search">

            <i class="bi bi-search"></i>

            <input type="text" id="musicSearch" class="form-control"
                   placeholder="Search songs, composers, One License, key or Mass part..." autocomplete="off" />

            <button type="button" id="clearMusicSearch" class="library-search-clear" title="Clear search"
                    aria-label="Clear search">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>


        <div class="library-toolbar-info">

            <i class="bi bi-lightning-charge"></i>

            Search your library instantly

        </div>

    </div>

    <!-- MUSIC LIBRARY FILTERS -->

    <div class="library-filters mb-3">

        <div class="library-filter-label">
            <i class="bi bi-funnel"></i>
            Filter
        </div>

        <div class="library-filter-chips">

            <a asp-page="/MusicLibrary/Index"
               class="library-filter-chip @(string.IsNullOrWhiteSpace(Model.Filter) ? "active" : "")">
                All
            </a>


            @if (Model.NeedsAttentionCount > 0)
            {
                <a asp-page="/MusicLibrary/Index" asp-route-filter="needs-attention"
                   class="library-filter-chip library-filter-attention @(Model.Filter == "needs-attention" ? "active" : "")">

                    <i class="bi bi-exclamation-circle"></i>
                    Needs Attention

                    <span>@Model.NeedsAttentionCount</span>

                </a>
            }


            @if (Model.MissingLyricsCount > 0)
            {
                <a asp-page="/MusicLibrary/Index" asp-route-filter="missing-lyrics"
                   class="library-filter-chip @(Model.Filter == "missing-lyrics" ? "active" : "")">

                    <i class="bi bi-file-earmark-slides"></i>
                    Missing Lyrics

                    <span>@Model.MissingLyricsCount</span>

                </a>
            }


            @if (Model.MissingPdfCount > 0)
            {
                <a asp-page="/MusicLibrary/Index" asp-route-filter="missing-pdf"
                   class="library-filter-chip @(Model.Filter == "missing-pdf" ? "active" : "")">

                    <i class="bi bi-file-earmark-pdf"></i>
                    Missing PDF

                    <span>@Model.MissingPdfCount</span>

                </a>
            }


            @if (Model.MissingOneLicenseCount > 0)
            {
                <a asp-page="/MusicLibrary/Index" asp-route-filter="missing-one-license"
                   class="library-filter-chip @(Model.Filter == "missing-one-license" ? "active" : "")">

                    <i class="bi bi-shield-check"></i>
                    Missing One License

                    <span>@Model.MissingOneLicenseCount</span>

                </a>
            }


            @if (Model.MissingComposerCount > 0)
            {
                <a asp-page="/MusicLibrary/Index" asp-route-filter="missing-composer"
                   class="library-filter-chip @(Model.Filter == "missing-composer" ? "active" : "")">

                    <i class="bi bi-person"></i>
                    Missing Composer

                    <span>@Model.MissingComposerCount</span>

                </a>
            }

        </div>

    </div>
    <div class="presentation-library-table-card">

        <div class="table-responsive">

            <table class="table align-middle presentation-library-table js-sortable-table" id="musicTable">

                <thead>
                    <tr>

                        <th data-sort="text">
                            Song
                        </th>

                        <th data-sort="text">
                            Mass Part
                        </th>

                        <th data-sort="text">
                            Composer
                        </th>

                        <th data-sort="text">
                            One License
                        </th>

                        <th data-sort="text">
                            Key
                        </th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var Song in Model.Songs)
                    {
                        <tr>

                            <!-- SONG -->

                            <td>

                                <div class="presentation-item-title">

                                    <div class="presentation-item-mark music-library-mark">

                                        <i class="bi bi-music-note-beamed"></i>

                                    </div>

                                    <div>

                                        <a asp-page="Edit" asp-route-id="@Song.Id"
                                           asp-route-returnUrl="@($"{Request.Path}{Request.QueryString}")"
                                           class="presentation-item-name">

                                            @Song.Title

                                        </a>


                                        <div class="music-library-row-meta">

                                            @if (!string.IsNullOrWhiteSpace(Song.PdfPath))
                                            {
                                                <span class="music-library-ready" title="PDF available" data-bs-toggle="tooltip">

                                                    <i class="bi bi-file-earmark-pdf"></i>
                                                    PDF

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="music-library-missing" title="PDF missing" data-bs-toggle="tooltip">

                                                    <i class="bi bi-file-earmark-pdf"></i>
                                                    No PDF

                                                </span>
                                            }


                                            @if (!string.IsNullOrWhiteSpace(Song.PresentationLyrics))
                                            {
                                                <span class="music-library-ready" title="Presentation lyrics available"
                                                      data-bs-toggle="tooltip">

                                                    <i class="bi bi-file-earmark-slides"></i>
                                                    Lyrics

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="music-library-missing" title="Presentation lyrics missing"
                                                      data-bs-toggle="tooltip">

                                                    <i class="bi bi-file-earmark-slides"></i>
                                                    No Lyrics

                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>

                            </td>


                            <!-- MASS PART -->

                            <td>

                                @if (!string.IsNullOrWhiteSpace(
                                    Song.SuggestedMassPart))
                                {
                                    <span class="presentation-type-badge music-mass-part-badge">
                                        @Song.SuggestedMassPart
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }

                            </td>


                            <!-- COMPOSER -->

                            <td>

                                @if (!string.IsNullOrWhiteSpace(Song.Composer))
                                {
                                    <span class="music-library-composer">
                                        @Song.Composer
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }

                            </td>


                            <!-- ONE LICENSE -->

                            <td>

                                @if (!string.IsNullOrWhiteSpace(
                                    Song.OneLicenseNumber))
                                {
                                    <span class="music-license-badge ready">

                                        <i class="bi bi-check-circle-fill"></i>

                                        @Song.OneLicenseNumber

                                    </span>
                                }
                                else
                                {
                                    <span class="music-license-badge missing">

                                        <i class="bi bi-exclamation-circle"></i>

                                        Missing

                                    </span>
                                }

                            </td>


                            <!-- KEY -->

                            <td>

                                @if (!string.IsNullOrWhiteSpace(Song.Key))
                                {
                                    <span class="music-key-badge">
                                        @Song.Key
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }

                            </td>


                            <!-- ACTIONS -->

                            <td class="text-end">

                                <div class="d-inline-flex gap-2">

                                    <a asp-page="Edit" asp-route-id="@Song.Id"
                                       asp-route-returnUrl="@($"{Request.Path}{Request.QueryString}")"
                                       class="btn btn-sm btn-outline-secondary table-action" title="Edit"
                                       data-bs-toggle="tooltip">

                                        <i class="bi bi-pencil"></i>

                                    </a>


                                    @if (!string.IsNullOrWhiteSpace(Song.PdfPath))
                                    {
                                        <a asp-page="View" asp-route-id="@Song.Id" target="_blank" rel="noopener noreferrer"
                                           class="btn btn-sm btn-outline-primary table-action" title="View PDF"
                                           data-bs-toggle="tooltip">

                                            <i class="bi bi-file-earmark-pdf"></i>

                                        </a>
                                    }


                                    <a asp-page-handler="GeneratePpt" asp-route-id="@Song.Id"
                                       class="btn btn-sm btn-outline-secondary table-action" title="Generate PowerPoint"
                                       data-bs-toggle="tooltip">

                                        <i class="bi bi-file-earmark-slides"></i>

                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-page="Delete" asp-route-id="@Song.Id"
                                        class="btn btn-sm btn-outline-danger table-action" title="Delete"
                                        data-bs-toggle="tooltip">

                                            <i class="bi bi-trash"></i>

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

}
@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("musicSearch");

            const clearButton =
                document.getElementById("clearMusicSearch");

            const rows =
                document.querySelectorAll("#musicTable tbody tr");


            function filterMusic() {

                if (!searchInput) {
                    return;
                }

                const search =
                    searchInput.value
                        .toLowerCase()
                        .trim();


                rows.forEach(row => {

                    const text =
                        row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(search)
                            ? ""
                            : "none";
                });


                if (clearButton) {

                    clearButton.classList.toggle(
                        "is-visible",
                        search.length > 0
                    );
                }
            }


            searchInput?.addEventListener(
                "input",
                filterMusic
            );


            clearButton?.addEventListener(
                "click",
                function () {

                    if (!searchInput) {
                        return;
                    }

                    searchInput.value = "";

                    filterMusic();

                    searchInput.focus();
                }
            );

        });
    </script>
}