@page
@model choir_music_system.Pages.MusicLibrary.IndexModel

@{
    ViewData["Title"] = "Music Library";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Music Library</h1>
        <p class="text-muted mb-0">
            Manage choir music sheets.
        </p>
    </div>

    <a asp-page="Create" class="btn btn-primary">
        Upload Music Sheet
    </a>
</div>

@if (Model.MusicSheets.Count == 0)
{
    <div class="alert alert-info">
        No music sheets have been uploaded yet.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Suggested Part</th>
                <th>Composer</th>
                <th>Arrangement</th>
                <th>Key</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var musicSheet in Model.MusicSheets)
            {
                <tr>
                    <td>@musicSheet.Title</td>

                    <td>
                        @(string.IsNullOrWhiteSpace(musicSheet.SuggestedMassPart)
                            ? "-"
                            : musicSheet.SuggestedMassPart)
                    </td>

                    <td>@musicSheet.Composer</td>

                    <td>@musicSheet.Arrangement</td>

                    <td>@musicSheet.Key</td>

                    <td class="text-end">
                        <a asp-page="View" asp-route-id="@musicSheet.Id" target="_blank" class="btn btn-sm btn-outline-primary">
                            View PDF
                        </a>
                        <a asp-page="Edit" asp-route-id="@musicSheet.Id" class="btn btn-sm btn-outline-secondary">
                            Edit
                        </a>

                        <a asp-page="Delete" asp-route-id="@musicSheet.Id" class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
}