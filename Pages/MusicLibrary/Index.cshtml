@page
@model choir_music_system.Pages.MusicLibrary.IndexModel

@{
    ViewData["Title"] = "Music Library";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Music Library</h1>
        <p class="text-muted mb-0">
            Manage choir music sheets.
        </p>
    </div>

    <a asp-page="Create" class="btn btn-primary app-primary-action">
        <i class="bi bi-cloud-arrow-up"></i>
        <span>Upload Music Sheet</span>
    </a>
</div>

@if (Model.Songs.Count == 0)
{
    <div class="alert alert-info">
        No music sheets have been uploaded yet.
    </div>
}
else
{
    <div class="mb-3">
        <input type="text" id="musicSearch" class="form-control"
               placeholder="Search title, composer, arrangement, key or suggested part..." autocomplete="off" />
    </div>
    <table class="table table-hover align-middle" id="musicTable">
        <thead>
            <tr>
                <th>Title</th>
                <th>Suggested Part</th>
                <th>Composer</th>
                <th>One License</th>
                <th>Key</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var Song in Model.Songs)
            {
                <tr>
                    <td>@Song.Title</td>

                    <td>
                        @(string.IsNullOrWhiteSpace(Song.SuggestedMassPart)
                            ? "-"
                            : Song.SuggestedMassPart)
                    </td>

                    <td>@Song.Composer</td>

                    <td>
                        @if (!string.IsNullOrWhiteSpace(Song.OneLicenseNumber))
                        {
                            @Song.OneLicenseNumber
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>

                    <td>@Song.Key</td>

                    <td class="text-end">
                        <a asp-page="Edit" asp-route-id="@Song.Id"
                           asp-route-returnUrl="@($"{Request.Path}{Request.QueryString}")"
                           class="btn btn-sm btn-outline-secondary table-action" title="Edit" data-bs-toggle="tooltip">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-page="View" asp-route-id="@Song.Id" target="_blank" rel="noopener noreferrer"
                           class="btn btn-sm btn-outline-primary table-action" title="View PDF" data-bs-toggle="tooltip">
                            <i class="bi bi-file-earmark-pdf"></i>
                        </a>
                        <a asp-page-handler="GeneratePpt" asp-route-id="@Song.Id"
                           class="btn btn-sm btn-outline-secondary table-action" title="Generate PowerPoint"
                           data-bs-toggle="tooltip">
                            <i class="bi bi-file-earmark-slides"></i>
                        </a>
                        <a asp-page="Delete" asp-route-id="@Song.Id" class="btn btn-sm btn-outline-danger table-action"
                           title="Delete" data-bs-toggle="tooltip">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@section Scripts
{
    <script>
        const searchInput = document.getElementById("musicSearch");
        const rows = document.querySelectorAll("#musicTable tbody tr");

        searchInput?.addEventListener("input", function () {
            const search = this.value
                .toLowerCase()
                .trim();

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();

                row.style.display =
                    text.includes(search) ? "" : "none";
            });
        });
    </script>
}