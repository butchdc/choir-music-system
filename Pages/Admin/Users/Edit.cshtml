@page "{id:int}"
@model choir_music_system.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">Edit User</h1>
        <p class="text-muted mb-0">
            Change access and role for this user.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Google Email</label>

                    <input asp-for="Email"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Role"
                           class="form-label">
                        Role
                    </label>

                    <select asp-for="Role"
                            class="form-select">

                        <option value="Member">Member</option>
                        <option value="Admin">Admin</option>

                    </select>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                        Active
                    </label>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-page="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>