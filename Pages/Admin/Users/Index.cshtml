@page
@model choir_music_system.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "User Management";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">User Management</h1>
            <p class="text-muted mb-0">
                Manage access to the Choir Music System.
            </p>
        </div>

        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i>
            Invite User
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@(user.DisplayName ?? "—")</td>

                            <td>@user.Email</td>

                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-primary">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Member</span>
                                }
                            </td>

                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Disabled</span>
                                }
                            </td>

                            <td>
                                @if (user.LastLoginAt.HasValue)
                                {
                                    @(user.LastLoginAt.Value.ToLocalTime().ToString("dd MMM yyyy h:mm tt"))
                                }
                                else
                                {
                                    <span class="text-muted">Never</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>
