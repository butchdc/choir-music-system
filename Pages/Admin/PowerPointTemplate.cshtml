@page
@model choir_music_system.Pages.Admin.PowerPointTemplateModel
@{
    ViewData["Title"] = "PowerPoint Template";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">
            PowerPoint Template
        </h1>

        <p class="text-muted mb-0">
            Download, edit and replace the template used for generated presentations.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-info">
            @Model.StatusMessage
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h2 class="h5">
                        Current Template
                    </h2>

                    @if (Model.TemplateExists)
                    {
                        <p class="mb-1">
                            <strong>Template.pptx</strong>
                        </p>

                        @if (Model.LastModified.HasValue)
                        {
                            <p class="text-muted">
                                Last updated:
                                @Model.LastModified.Value.ToString("dd MMM yyyy h:mm tt")
                            </p>
                        }

                        <a asp-page-handler="Download"
                           class="btn btn-outline-primary">
                            <i class="bi bi-download me-1"></i>
                            Download Current Template
                        </a>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            No PowerPoint template is currently available.
                        </div>
                    }

                </div>
            </div>

        </div>

        <div class="col-lg-6">

            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h2 class="h5">
                        Replace Template
                    </h2>

                    <p class="text-muted">
                        Upload an updated .pptx template. The current template will be archived before it is replaced.
                    </p>

                    <form method="post"
                          enctype="multipart/form-data"
                          asp-page-handler="Upload">

                        <div class="mb-3">

                            <label asp-for="TemplateFile"
                                   class="form-label">
                                PowerPoint Template
                            </label>

                            <div class="app-file-picker">

                                <input asp-for="TemplateFile"
                                    type="file"
                                    accept=".pptx"
                                    class="app-file-picker-input" />

                                <label for="TemplateFile"
                                    class="app-file-picker-button">
                                    Choose File
                                </label>

                                <span class="app-file-picker-name">
                                    No file selected
                                </span>

                            </div>

                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-upload me-1"></i>
                            Upload & Replace
                        </button>

                    </form>

                </div>
            </div>

        </div>

    </div>

    @if (Model.CurrentLayouts.Count > 0)
    {
        <div class="card shadow-sm mt-4">

            <div class="card-body">

                <h2 class="h5">
                    Current Template Layouts
                </h2>

                <div class="d-flex flex-wrap gap-2 mt-3">

                    @foreach (var layout in Model.CurrentLayouts)
                    {
                        <span class="badge text-bg-light border">
                            @layout
                        </span>
                    }

                </div>

            </div>

        </div>
    }

</div>