@page
@model choir_music_system.Pages.Admin.BackupModel

@{
    ViewData["Title"] = "Backup & Restore";
}

<div class="backup-page">

    <!-- HEADER -->

    <div class="backup-header">

        <div class="backup-heading">

            <div class="backup-heading-icon">
                <i class="bi bi-database-check"></i>
            </div>

            <div>

                <div class="backup-kicker">
                    System Administration
                </div>

                <h1>Backup & Restore</h1>

                <p>
                    Protect your Choir Music System data or move
                    it safely between environments.
                </p>

            </div>

        </div>

    </div>


    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="backup-status">

            <div class="backup-status-icon">
                <i class="bi bi-info-circle"></i>
            </div>

            <div>
                @Model.StatusMessage
            </div>

        </div>
    }


    <!-- OVERVIEW -->

    <div class="backup-overview">

        <div class="backup-overview-item">

            <div class="backup-overview-icon database">
                <i class="bi bi-database"></i>
            </div>

            <div>
                <strong>Database</strong>
                <span>
                    Masses, songs, templates and library data
                </span>
            </div>

        </div>


        <div class="backup-overview-item">

            <div class="backup-overview-icon files">
                <i class="bi bi-folder2-open"></i>
            </div>

            <div>
                <strong>Stored Files</strong>
                <span>
                    Music sheets and system content
                </span>
            </div>

        </div>


        <div class="backup-overview-item">

            <div class="backup-overview-icon excluded">
                <i class="bi bi-file-earmark-slides"></i>
            </div>

            <div>
                <strong>Generated Files</strong>
                <span>
                    Temporary generated outputs are excluded
                </span>
            </div>

        </div>

    </div>


    <div class="backup-grid">


        <!-- EXPORT -->

        <section class="backup-card backup-export-card">

            <div class="backup-card-header">

                <div class="backup-card-icon export">
                    <i class="bi bi-cloud-arrow-down"></i>
                </div>

                <div>

                    <div class="backup-card-kicker">
                        Create Backup
                    </div>

                    <h2>Export Backup</h2>

                    <p>
                        Download a portable copy of your current
                        Choir Music System data.
                    </p>

                </div>

            </div>


            <div class="backup-card-body">

                <div class="backup-feature">

                    <i class="bi bi-check-circle-fill"></i>

                    <span>
                        Includes the application database
                    </span>

                </div>


                <div class="backup-feature">

                    <i class="bi bi-check-circle-fill"></i>

                    <span>
                        Includes stored music and system files
                    </span>

                </div>


                <div class="backup-feature">

                    <i class="bi bi-check-circle-fill"></i>

                    <span>
                        Suitable for transferring data between
                        environments
                    </span>

                </div>


                <div class="backup-note">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        Generated presentations and other temporary
                        output files are not included.
                    </span>

                </div>

            </div>


            <form method="post"
                  asp-page-handler="Export">

                <button type="submit"
                        class="btn backup-export-button">

                    <i class="bi bi-download me-1"></i>
                    Export Backup

                </button>

            </form>

        </section>



        <!-- RESTORE -->

        <section class="backup-card backup-restore-card">

            <div class="backup-card-header">

                <div class="backup-card-icon restore">
                    <i class="bi bi-cloud-arrow-up"></i>
                </div>

                <div>

                    <div class="backup-card-kicker restore">
                        Restore System
                    </div>

                    <h2>Import Backup</h2>

                    <p>
                        Restore system data from a previously
                        exported backup file.
                    </p>

                </div>

            </div>


            <div class="backup-card-body">

                <div class="backup-restore-warning">

                    <i class="bi bi-exclamation-triangle-fill"></i>

                    <div>

                        <strong>
                            Restore replaces the current system data.
                        </strong>

                        <span>
                            A safety backup of the current database
                            will be created before the restore begins.
                        </span>

                    </div>

                </div>


                <form method="post"
                      asp-page-handler="Import"
                      enctype="multipart/form-data">

                    <div class="backup-upload">

                        <div class="backup-upload-icon">
                            <i class="bi bi-file-earmark-zip"></i>
                        </div>

                        <div class="backup-upload-content">

                            <label asp-for="BackupFile"
                                   class="form-label">
                                Backup File
                            </label>

                            <div class="app-file-picker">

                                <input asp-for="BackupFile"
                                    type="file"
                                    accept=".zip,application/zip"
                                    class="app-file-picker-input"
                                    required />

                                <label for="BackupFile"
                                    class="app-file-picker-button">
                                    Choose File
                                </label>

                                <span class="app-file-picker-name">
                                    No file selected
                                </span>

                            </div>

                            <div class="backup-upload-help">
                                Select a ZIP backup exported by
                                Choir Music System.
                            </div>

                        </div>

                    </div>


                    <button type="submit"
                            class="btn backup-restore-button"
                            onclick="return confirm('This will replace the current system data. Continue?');">

                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Restore Backup

                    </button>

                </form>

            </div>

        </section>

    </div>


    <!-- SAFETY INFO -->

    <div class="backup-safety">

        <div class="backup-safety-icon">
            <i class="bi bi-shield-check"></i>
        </div>

        <div>

            <strong>
                Backup before major changes
            </strong>

            <p>
                Create a fresh backup before major library updates,
                application upgrades or moving the system to another
                environment.
            </p>

        </div>

    </div>

</div>