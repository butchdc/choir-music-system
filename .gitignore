# ============================================
# Choir Music System
# ============================================


# --------------------------------------------
# .NET
# --------------------------------------------

bin/
obj/
publish/
artifacts/


# --------------------------------------------
# IDEs / Editors
# --------------------------------------------

.vs/
.vscode/
.idea/

*.user
*.suo
*.userosscache
*.sln.docstates
*.sln.iml


# --------------------------------------------
# Operating System
# --------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini


# --------------------------------------------
# Database
# EF Core migrations remain in Git.
# Runtime database files do not.
# --------------------------------------------

#Data/

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3


# --------------------------------------------
# Application Storage
# User-uploaded PDFs must not be committed.
#
# MusicSheets = existing storage location
# Songs       = future storage location
# --------------------------------------------

Storage/MusicSheets/*
!Storage/MusicSheets/.gitkeep

Storage/Songs/*
!Storage/Songs/.gitkeep


# --------------------------------------------
# Generated Files
# --------------------------------------------

Storage/Generated/*
!Storage/Generated/.gitkeep


# --------------------------------------------
# PowerPoint
# Keep folders, not local/user content.
# --------------------------------------------

Storage/PowerPointTemplates/*
!Storage/PowerPointTemplates/.gitkeep
!Storage/PowerPointTemplates/Template.pptx

Storage/Backgrounds/*
!Storage/Backgrounds/.gitkeep


# --------------------------------------------
# Temporary Storage
# --------------------------------------------

Storage/Temp/*
!Storage/Temp/.gitkeep

*.tmp
*.temp
*.bak
*.swp
*~


# --------------------------------------------
# Other User Uploads
# --------------------------------------------

uploads/


# --------------------------------------------
# Logs
# --------------------------------------------

logs/
*.log


# --------------------------------------------
# Environment / Secrets
# --------------------------------------------

.env
.env.*
!.env.example

appsettings.Local.json
appsettings.*.Local.json


# --------------------------------------------
# Tests / Coverage
# --------------------------------------------

TestResults/
coverage/
coverage.xml
coverage.json
*.coverage
*.coveragexml


# --------------------------------------------
# NuGet
# --------------------------------------------

*.nupkg
*.snupkg
packages/

!packages.lock.json

# Production database backups
backups/