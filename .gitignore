# ============================================
# Choir Music System
# ============================================


# --------------------------------------------
# .NET
# --------------------------------------------

bin/
obj/
publish/
artifacts/


# --------------------------------------------
# IDEs / Editors
# --------------------------------------------

.vs/
.vscode/
.idea/

*.user
*.suo
*.userosscache
*.sln.docstates
*.sln.iml


# --------------------------------------------
# Operating System
# --------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini


# --------------------------------------------
# Database
# EF Core migrations remain in Git.
# Runtime database files do not.
# --------------------------------------------

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3


# --------------------------------------------
# Application Storage
# Runtime/user-uploaded content must not
# be committed.
# --------------------------------------------

# Music PDFs / uploaded music files
Storage/MusicSheets/*
!Storage/MusicSheets/.gitkeep

Storage/Songs/*
!Storage/Songs/.gitkeep


# --------------------------------------------
# Custom PowerPoint Uploads
# --------------------------------------------

# Custom PowerPoints attached to songs
Storage/SongPresentations/*
!Storage/SongPresentations/.gitkeep

# Manually edited/final PowerPoints for Masses
Storage/MassPresentations/*
!Storage/MassPresentations/.gitkeep


# --------------------------------------------
# Generated Files
# Generated PowerPoints and other output
# --------------------------------------------

Storage/Generated/*
!Storage/Generated/.gitkeep


# --------------------------------------------
# PowerPoint Template
# Keep the default system template in Git.
# Runtime replacement templates should
# otherwise not be committed.
# --------------------------------------------

Storage/PowerPointTemplates/*
!Storage/PowerPointTemplates/.gitkeep
!Storage/PowerPointTemplates/Template.pptx


# --------------------------------------------
# Mass Background Images
# User-uploaded background images.
# --------------------------------------------

Storage/Backgrounds/*
!Storage/Backgrounds/.gitkeep


# --------------------------------------------
# Temporary Storage
# --------------------------------------------

Storage/Temp/*
!Storage/Temp/.gitkeep


# --------------------------------------------
# Other User Uploads
# --------------------------------------------

uploads/


# --------------------------------------------
# Backup Files
# Production/application backups must never
# be committed to source control.
# --------------------------------------------

backups/
Backups/

*.bak


# --------------------------------------------
# Temporary Files
# --------------------------------------------

*.tmp
*.temp
*.swp
*~


# --------------------------------------------
# Logs
# --------------------------------------------

logs/
*.log


# --------------------------------------------
# Environment / Secrets
# --------------------------------------------

.env
.env.*
!.env.example

appsettings.Local.json
appsettings.*.Local.json


# --------------------------------------------
# Tests / Coverage
# --------------------------------------------

TestResults/
coverage/
coverage.xml
coverage.json
*.coverage
*.coveragexml


# --------------------------------------------
# NuGet
# --------------------------------------------

*.nupkg
*.snupkg
packages/

!packages.lock.json